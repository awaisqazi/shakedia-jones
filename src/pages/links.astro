---
// Link-in-bio page for social profiles. No navbar, footer or action bar: just the links.
import Layout from '../layouts/Layout.astro';
import Logo from '../components/ui/Logo.astro';
import Star from '../components/ui/Star.astro';
import ShareBar from '../components/ui/ShareBar.astro';
import { SOCIALS, canDonate, donateHref, isExternalDonate } from '../data/campaign.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ext = isExternalDonate() ? { target: '_blank', rel: 'noopener' } : {};
const socials = SOCIALS.filter((s) => s.href);

// Donate shows only once donations are open (no solicitation before the committee exists).
const links = [
  { href: `${base}/join/#signup`, key: 'links.volunteer', label: 'Volunteer: join the team', sub: 'links.volunteer_sub', subLabel: 'Canvassing, phone banking, events', style: 'gold' },
  { href: `${base}/join/#yard-sign`, key: 'links.yard_sign', label: 'Host a yard sign', sub: 'links.yard_sign_sub', subLabel: 'Show your support on your block' },
  { href: `${base}/meet/`, key: 'links.meet', label: 'Meet Shakedia', sub: 'links.meet_sub', subLabel: 'USA Olympian. Coach. Neighbor.' },
  { href: `${base}/plan/`, key: 'links.plan', label: 'Priorities', sub: 'links.plan_sub', subLabel: 'Four priorities for the 1st Ward' },
  { href: donateHref(base), key: 'links.donate', label: 'Donate', sub: 'links.donate_sub', subLabel: 'Help build a stronger 1st Ward', style: 'outline', attrs: ext, donate: true },
].filter((l) => !l.donate || canDonate());
---

<Layout
  title="Shakedia Jones | Links"
  description="Every link for Shakedia Jones's campaign for 1st Ward Alderman in Waukegan: volunteer, meet Shakedia and read her priorities."
  actionBar={false}
>
  <main id="main" tabindex="-1" class="lk on-dark">
    <div class="lk-top">
      <a href={`${base}/`} class="lk-home" data-i18n="links.home">Full website</a>
      <div class="lk-lang" role="group" aria-label="Language" data-i18n-attr="aria-label:links.lang_label">
        <button type="button" data-lang-toggle="en" class="lk-lang-btn active" aria-label="English" lang="en" aria-pressed="true">EN</button>
        <button type="button" data-lang-toggle="es" class="lk-lang-btn" aria-label="Español" lang="es" aria-pressed="false">ES</button>
      </div>
    </div>

    <header class="lk-head">
      <div class="lk-photo">
        <img
          src={`${base}/images/campaign/avatar.webp`}
          width="480" height="480" decoding="async" fetchpriority="high"
          alt="Shakedia Jones smiling, in a green blazer and a gold top."
          data-i18n-attr="alt:links.photo_alt"
        />
      </div>
      <h1 class="lk-wordmark"><Logo variant="stacked" tone="dark" width={264} loading="eager" /></h1>
      <p class="lk-slogan script" data-i18n="ui.slogan">Building a Stronger 1st Ward Together</p>
    </header>

    <ul class="lk-list">
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={['lk-btn', l.style && `lk-${l.style}`]} {...(l.attrs || {})}>
            <span class="lk-btn-main" data-i18n={l.key}>{l.label}</span>
            <span class="lk-btn-sub" data-i18n={l.sub}>{l.subLabel}</span>
          </a>
        </li>
      ))}
    </ul>

    {socials.length > 0 && (
      <ul class="lk-social">
        {socials.map((s) => (
          <li>
            <a href={s.href} class="lk-social-link" aria-label={s.name} target="_blank" rel="noopener">
              {s.icon === 'ig' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>}
              {s.icon === 'fb' && <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>}
              {s.icon === 'tt' && <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.23 8.23 0 0 0 4.76 1.51V6.82a4.83 4.83 0 0 1-1-.13z"/></svg>}
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="lk-date">
      <Star size={22} />
      <p class="lk-date-text">
        <span class="lk-date-k" data-i18n="links.election_label">Primary</span>
        <span class="lk-date-v" data-i18n="links.election_value">Tuesday, February 23, 2027</span>
      </p>
      <Star size={22} />
    </div>

    <footer class="lk-foot">
      <div class="gold-rule lk-rule" aria-hidden="true"></div>
      <ShareBar variant="dark" class="lk-share" compact />
      <p class="lk-paid" data-i18n="footer.paid_for">Paid for by Friends of Shakedia Jones</p>
      <!-- Statutory ISBE notice: the English text stays visible in both languages; the Spanish line is added under it. -->
      <p class="lk-disc" lang="en">A copy of our report filed with the State Board of Elections is (or will be) available on the Board's official website (www.elections.il.gov) or for purchase from the State Board of Elections, Springfield, Illinois.</p>
      <p class="lk-disc lk-disc-es" lang="es" data-i18n="footer.disclosure"></p>
    </footer>
  </main>
</Layout>

<style>
  .lk {
    min-height: 100dvh; max-width: 520px; margin: 0 auto;
    padding: var(--space-md) var(--gutter) var(--space-2xl);
    display: flex; flex-direction: column; align-items: center; gap: var(--space-lg);
    color: rgba(255, 255, 255, 0.88);
  }
  :global(body:has(.lk)) {
    background-color: var(--purple-deep);
    background-image:
      radial-gradient(70% 420px at 50% 0, rgba(106, 31, 160, 0.9), transparent 75%),
      radial-gradient(60% 300px at 50% 100%, rgba(224, 69, 123, 0.28), transparent 75%),
      radial-gradient(circle at 20% 30%, rgba(254, 198, 10, 0.18) 0 1.2px, transparent 1.8px),
      radial-gradient(circle at 70% 70%, rgba(255, 255, 255, 0.1) 0 1.2px, transparent 1.8px);
    background-size: auto, auto, 52px 52px, 74px 74px;
    background-repeat: no-repeat, no-repeat, repeat, repeat;
  }

  .lk-top { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .lk-home {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.9rem;
    color: var(--gold); text-decoration: underline; text-underline-offset: 4px;
  }
  .lk-lang { display: flex; gap: 2px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(254, 198, 10, 0.35); border-radius: 999px; padding: 3px; }
  .lk-lang-btn {
    font-family: var(--font-label); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.08em;
    min-width: 44px; min-height: 44px; padding: 0 12px; border-radius: 999px; color: var(--white);
    transition: background var(--duration-fast), color var(--duration-fast);
  }
  .lk-lang-btn.active { background: var(--gold); color: var(--purple-deep); }
  .lk-lang-btn:hover:not(.active) { background: rgba(255, 255, 255, 0.16); }

  .lk-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-md); }
  .lk-photo {
    width: 168px; height: 168px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--purple);
    box-shadow: 0 0 0 5px var(--gold), 0 0 0 11px rgba(254, 198, 10, 0.2), var(--shadow-xl);
    margin: var(--space-sm) 0 var(--space-sm);
  }
  /* 480x480 source has part of a lettered graphic on the right edge: zoom slightly toward the face. */
  .lk-photo img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); transform-origin: 46% 42%; }
  .lk-wordmark { font-size: inherit; line-height: 1; width: 264px; max-width: 100%; }
  .lk-slogan { font-size: clamp(1.35rem, 1.2rem + 0.8vw, 1.7rem); color: var(--gold); max-width: none; margin-top: var(--space-xs); }

  .lk-list { width: 100%; display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-sm); }
  .lk-btn {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; text-align: center;
    min-height: 66px; width: 100%; padding: 0.75rem 1.2rem;
    background: var(--white); color: var(--purple); border-radius: var(--radius-lg); border: 2px solid var(--white);
    border-top: 4px solid var(--gold);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.25);
    transition: transform var(--duration-fast) var(--ease-default), background var(--duration-normal), border-color var(--duration-normal);
  }
  .lk-btn:hover { transform: translateY(-2px); background: var(--cream); }
  .lk-btn:focus-visible { outline-color: var(--gold); }
  .lk-btn-main { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; line-height: 1.1; }
  .lk-btn-sub { font-family: var(--font-label); font-weight: 600; text-transform: uppercase; font-size: 0.86rem; letter-spacing: 0.1em; color: var(--muted); line-height: 1.2; }
  .lk-gold { background: var(--gold-sheen); border-color: var(--gold); color: var(--purple-deep); }
  .lk-gold:hover { background: var(--gold-light); }
  .lk-gold .lk-btn-sub { color: var(--purple-deep); }
  .lk-outline { background: transparent; border-color: rgba(255, 255, 255, 0.75); border-top-color: var(--gold); color: var(--white); box-shadow: none; }
  .lk-outline:hover { background: rgba(255, 255, 255, 0.1); }
  .lk-outline .lk-btn-sub { color: rgba(255, 255, 255, 0.8); }

  .lk-social { display: flex; gap: var(--space-sm); }
  .lk-social-link {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.1); color: var(--white); box-shadow: inset 0 0 0 1px rgba(254, 198, 10, 0.45); transition: background var(--duration-fast);
  }
  .lk-social-link:hover { background: var(--purple); }

  .lk-date { display: flex; align-items: center; justify-content: center; gap: var(--space-md); }
  .lk-date-text { display: flex; flex-direction: column; align-items: center; text-align: center; max-width: none; }
  .lk-date-k { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; font-size: var(--text-xs); color: rgba(255, 255, 255, 0.8); }
  .lk-date-v { font-variant-numeric: lining-nums; font-family: var(--font-display); font-weight: 800; font-size: var(--text-xl); color: var(--gold); line-height: 1.15; }

  .lk-foot { width: 100%; margin-top: var(--space-lg); display: flex; flex-direction: column; align-items: center; gap: var(--space-md); }
  .lk-rule { width: 100%; }
  .lk-share { margin: var(--space-md) 0 var(--space-lg); }
  .lk-share :global(.sb-row) { justify-content: center; }
  .lk-paid {
    font-family: var(--font-label); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: var(--text-xs);
    color: var(--white); border: 1px solid rgba(254, 198, 10, 0.5); padding: 5px 12px; border-radius: 4px; text-align: center; max-width: 100%;
  }
  .lk-disc { font-size: 0.78rem; line-height: 1.5; color: rgba(255, 255, 255, 0.72); text-align: center; max-width: 46ch; margin: 0; }
  .lk-disc-es:empty { display: none; }

  @media (max-width: 380px) {
    .lk-photo { width: 140px; height: 140px; }
    .lk-btn-main { font-size: 1.22rem; }
    .lk-date-v { font-size: 1.15rem; }
  }
</style>
