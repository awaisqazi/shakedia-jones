---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MeetHero from '../components/meet/MeetHero.astro';
import MeetNumbers from '../components/meet/MeetNumbers.astro';
import MeetStory from '../components/meet/MeetStory.astro';
import MeetQuote from '../components/meet/MeetQuote.astro';
import MeetHonor from '../components/meet/MeetHonor.astro';
import MeetNews from '../components/meet/MeetNews.astro';
import MeetCTA from '../components/meet/MeetCTA.astro';
import shared from '../i18n/parts/shared.en.json';
---

<Layout title={shared.meta.meet.title} description={shared.meta.meet.description}>
  <Navbar />
  <main id="main" tabindex="-1">
    <MeetHero />
    <MeetNumbers />
    <MeetStory />
    <MeetQuote />
    <MeetHonor />
    <MeetNews />
    <MeetCTA />
  </main>
  <Footer />
</Layout>
