---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Priorities from '../components/home/Priorities.astro';
import Excellence from '../components/home/Excellence.astro';
import FlySpotlight from '../components/home/FlySpotlight.astro';
import JoinBand from '../components/home/JoinBand.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Shakedia Jones for 1st Ward Alderman | Waukegan"
  description="USA Olympian, 17-time Illinois state champion and FLY founder Shakedia Jones is running for 1st Ward Alderman in Waukegan. Primary: Feb 23, 2027."
>
  <Navbar />
  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Priorities />
    <Excellence />
    <FlySpotlight />
    <JoinBand />
  </main>
  <Footer />
</Layout>
