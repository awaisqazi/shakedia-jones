---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import JoinHero from '../components/join/JoinHero.astro';
import WaysToHelp from '../components/join/WaysToHelp.astro';
import SignupForm from '../components/join/SignupForm.astro';
import YardSignForm from '../components/join/YardSignForm.astro';
import DonateBlock from '../components/join/DonateBlock.astro';
import BeforeYouVote from '../components/join/BeforeYouVote.astro';
import JoinShare from '../components/join/JoinShare.astro';
---

<Layout
  title="Get Involved | Shakedia Jones for 1st Ward Alderman"
  description="Volunteer, knock doors, host a yard sign or help at events for Shakedia Jones in Waukegan's 1st Ward. Vote in the primary on Feb 23, 2027."
>
  <Navbar />
  <main id="main" tabindex="-1">
    <JoinHero />
    <WaysToHelp />
    <SignupForm />
    <YardSignForm />
    <DonateBlock />
    <BeforeYouVote />
    <JoinShare />
  </main>
  <Footer />
</Layout>
