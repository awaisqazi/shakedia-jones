---
// /plan/ "1st Ward Priorities": the campaign's four priorities (RETHEME.md, exact headlines),
// how she will work, a quote, and a call to join.
// DRAFT FOR CANDIDATE APPROVAL: every "why it matters" paragraph and every commitment
// (plan.p.*.c1 to c3, plus the monthly report-back in plan.how) in src/i18n/parts/plan.*.json
// is proposed wording awaiting Shakedia Jones's sign-off.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PlanHero from '../components/plan/PlanHero.astro';
import Priority from '../components/plan/Priority.astro';
import YouthRecord from '../components/plan/YouthRecord.astro';
import HowSheWorks from '../components/plan/HowSheWorks.astro';
import PlanQuote from '../components/plan/PlanQuote.astro';
import PlanCTA from '../components/plan/PlanCTA.astro';
---

<Layout
  title="Priorities | Shakedia Jones for 1st Ward Alderman"
  description="Safer streets, abandoned buildings, home renovation and a community center: Shakedia Jones's priorities for Waukegan's 1st Ward."
>
  <Navbar />
  <main id="main" tabindex="-1">
    <PlanHero />
    <Priority id="p1" n={1} icon="car" tone="cream" />
    <Priority id="p2" n={2} icon="buildings" tone="soft" />
    <Priority id="p3" n={3} icon="home" tone="cream" />
    <Priority id="p4" n={4} icon="people" tone="soft"><YouthRecord /></Priority>
    <HowSheWorks />
    <PlanQuote />
    <PlanCTA />
  </main>
  <Footer />
</Layout>
