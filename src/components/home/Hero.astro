---
import RaceClock from '../ui/RaceClock.astro';
import Ribbon from '../ui/Ribbon.astro';
import Star from '../ui/Star.astro';
import { DATES } from '../../data/campaign.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero bg-sunset" id="hero">
  <img class="hero-skyline" src={`${base}/images/campaign/skyline.webp`} width="1300" height="150" alt="" aria-hidden="true" decoding="async" />

  <div class="container-wide hero-inner">
    <div class="hero-copy">
      <p class="kicker hero-kicker animate-in" style="--reveal-delay: 0s" data-i18n="home.hero.kicker">Waukegan · 1st Ward · Primary February 23, 2027</p>

      <h1 class="hero-headline">
        <span class="hl-1 animate-in" style="--reveal-delay: 0.08s" data-i18n="home.hero.headline_1">She ran for Team USA.</span>
        <span class="hl-2 animate-in" style="--reveal-delay: 0.18s" data-i18n="home.hero.headline_2">Now she's running for the 1st Ward.</span>
      </h1>

      <div class="hero-brand animate-in" style="--reveal-delay: 0.26s">
        <Ribbon size="lg" />
        <p class="script hero-slogan" data-i18n="ui.slogan">Building a Stronger 1st Ward Together</p>
      </div>

      <p class="hero-sub animate-in" style="--reveal-delay: 0.32s" data-i18n="home.hero.sub">Born and raised in the 1st Ward of Waukegan. 17-time Illinois state champion, member of the 2000 U.S. Olympic Team (4x100m relay pool), and founder of FLY, which by her 2024 count has helped more than 600 young people. Now she wants to work for her neighbors.</p>

      <div class="hero-ctas animate-in" style="--reveal-delay: 0.38s">
        <a href={`${base}/join/#signup`} class="btn btn-gold btn-massive" data-i18n="home.hero.cta_join">Join the team</a>
        <a href={`${base}/meet/`} class="btn btn-outline-light" data-i18n="home.hero.cta_meet">Meet Shakedia</a>
      </div>

      <div class="hero-clock animate-in" style="--reveal-delay: 0.44s">
        <RaceClock date={DATES.primary} labelKey="home.hero.countdown" label="days until the primary" />
      </div>
    </div>

    <div class="hero-visual animate-in" style="--reveal-delay: 0.14s">
      <Star class="hv-star hv-star-1" />
      <Star class="hv-star hv-star-2" />
      <Star class="hv-star hv-star-3" />
      <figure class="hero-arch">
        <img
          src={`${base}/images/campaign/portrait-purple.webp`}
          width="800" height="1024"
          alt="Shakedia Jones smiling, in a green blazer and a gold top."
          data-i18n-attr="alt:home.hero.photo_alt" fetchpriority="high" decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    --sky-h: clamp(84px, 9vw, 150px);
    position: relative; overflow: hidden;
    padding-top: calc(var(--nav-height) + var(--space-2xl));
  }
  /* The flyers' skyline, pinned to the bottom and fading up into the sky */
  .hero-skyline {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 0;
    width: 100%; height: var(--sky-h); object-fit: cover; object-position: center bottom;
    -webkit-mask-image: linear-gradient(to top, #000 55%, transparent);
    mask-image: linear-gradient(to top, #000 55%, transparent);
  }

  .hero-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-2xl); align-items: end;
  }
  .hero-copy { padding-bottom: calc(var(--sky-h) + var(--space-lg)); }
  .hero-kicker { margin-bottom: var(--space-lg); }

  .hero-headline {
    display: flex; flex-direction: column; gap: 0.06em;
    font-size: clamp(2.5rem, 1.35rem + 3.6vw, 4.7rem); line-height: 0.98; margin-bottom: var(--space-xl);
    text-shadow: 0 2px 18px rgba(29, 10, 46, 0.35);
  }
  .hl-1 { color: var(--white); }
  .hl-2 { color: var(--gold); }

  .hero-brand { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .hero-slogan {
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2.3rem); color: var(--white); max-width: none;
    text-shadow: 0 2px 10px rgba(29, 10, 46, 0.45); padding-left: 0.2em;
  }

  .hero-sub { font-size: var(--text-lg); color: rgba(255, 255, 255, 0.92); max-width: 56ch; margin-bottom: var(--space-xl); text-shadow: 0 1px 8px rgba(29, 10, 46, 0.35); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .hero-ctas .btn-outline-light { background: rgba(43, 7, 71, 0.35); }
  .hero-clock { display: flex; }

  /* Portrait: a purple arch with a gold ring, anchored to the bottom edge.
     The arch matches the photo's flat purple, so the photo melts into it. */
  .hero-visual { position: relative; z-index: 2; justify-self: center; width: min(430px, 100%); }
  .hero-visual::before {
    content: ''; position: absolute; inset: -14px -14px 0; border: 1.5px solid rgba(254, 198, 10, 0.75); border-bottom: 0;
    border-radius: 999px 999px 0 0; pointer-events: none;
  }
  .hero-arch {
    position: relative; overflow: hidden; aspect-ratio: 0.6;
    background: #4c0278; border: 5px solid var(--gold); border-bottom: 0;
    border-radius: 999px 999px 0 0;
    box-shadow: 0 -10px 50px rgba(29, 10, 46, 0.4), inset 0 0 0 1px rgba(29, 10, 46, 0.3);
  }
  /* The source has lettering at its right edge: keep the crop on her */
  .hero-arch img { width: 100%; height: 100%; object-fit: cover; object-position: 8% 100%; }
  .hero-visual :global(.hv-star) { position: absolute; z-index: 3; filter: drop-shadow(0 2px 6px rgba(29, 10, 46, 0.4)); }
  .hero-visual :global(.hv-star-1) { width: 34px; height: 34px; top: 4%; left: -6%; }
  .hero-visual :global(.hv-star-2) { width: 20px; height: 20px; top: 15%; left: -12%; }
  .hero-visual :global(.hv-star-3) { width: 26px; height: 26px; top: 9%; right: -8%; }

  @media (max-width: 860px) {
    .hero { padding-top: calc(var(--nav-height) + var(--space-lg)); }
    .hero-inner { grid-template-columns: 1fr; gap: var(--space-xl); }
    /* Her face first on phones: a compact head-and-shoulders arch */
    .hero-visual { order: -1; width: min(250px, 66vw); }
    .hero-visual::before { inset: -10px; border-bottom: 1.5px solid rgba(254, 198, 10, 0.75); border-radius: 999px 999px 34px 34px; }
    .hero-arch { aspect-ratio: 0.86; border-bottom: 5px solid var(--gold); border-radius: 999px 999px 26px 26px; }
    .hero-arch img { position: absolute; top: 0; left: -10%; width: 140%; max-width: none; height: auto; object-fit: initial; }
    .hero-copy { text-align: left; }
  }
  @media (max-width: 420px) {
    .hero-headline { font-size: 2.35rem; }
    .hero-brand :global(.ribbon) { font-size: 1.08rem; }
    .hero-ctas .btn { flex: 1 1 100%; }
  }
</style>
