---
import { donateHref, isExternalDonate, canDonate } from '../../data/campaign.js';
import ShareBar from '../ui/ShareBar.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ext = isExternalDonate() ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="join-band on-dark" id="join" aria-labelledby="joinband-title">
  <div class="jb-track" aria-hidden="true">
    <svg viewBox="0 0 600 900" preserveAspectRatio="xMaxYMid slice">
      <g fill="none" stroke="#fff" stroke-width="5">
        <path d="M600 40 H330 a290 290 0 0 0 0 580 H600" />
        <path d="M600 110 H330 a220 220 0 0 0 0 440 H600" />
        <path d="M600 180 H330 a150 150 0 0 0 0 300 H600" />
      </g>
    </svg>
  </div>
  <div class="container jb-inner">
    <span class="section-label"><span class="lane-chip" aria-hidden="true">6</span><span data-i18n="home.join.label">Your leg</span></span>
    <h2 class="section-title" id="joinband-title">
      <span data-i18n="home.join.title_1">Take the baton.</span>
    </h2>
    <p class="section-lede" data-i18n="home.join.lede">Sign a petition, knock a few doors, put up a yard sign, or tell a neighbor in English or Spanish. Every leg counts.</p>
    <div class="jb-ctas">
      <a href={`${base}/join/#signup`} class="btn btn-gold btn-massive" data-i18n="home.join.cta_join">Join the team</a>
      {canDonate() && <a href={donateHref(base)} class="btn btn-outline-light" data-i18n="home.join.cta_donate" {...ext}>Chip in</a>}
    </div>
    <ShareBar variant="dark" class="jb-share" />
  </div>
</section>

<style>
  .join-band { position: relative; overflow: hidden; background: var(--navy); padding: var(--space-5xl) 0; }
  .jb-track { position: absolute; top: 0; right: 0; bottom: 0; width: 55%; opacity: 0.14; pointer-events: none; }
  .jb-track svg { width: 100%; height: 100%; display: block; }
  .jb-inner { position: relative; }
  .jb-inner .section-title { font-size: var(--text-5xl); }
  .jb-ctas { display: flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-xl); }
  .jb-share { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--line-light); }
  @media (max-width: 768px) {
    .join-band { padding: var(--space-4xl) 0; }
    .jb-track { width: 90%; opacity: 0.1; }
  }
</style>
