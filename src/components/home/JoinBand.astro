---
import { donateHref, isExternalDonate, canDonate } from '../../data/campaign.js';
import ShareBar from '../ui/ShareBar.astro';
import Swoosh from '../ui/Swoosh.astro';
import Logo from '../ui/Logo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ext = isExternalDonate() ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="join-band bg-purple-deep" id="join" aria-labelledby="joinband-title">
  <Swoosh class="jb-swoosh jb-swoosh-top" />
  <div class="container jb-inner">
    <!-- The campaign seal as a stamp: right of the heading on wide screens, above the kicker on narrow ones -->
    <div class="jb-seal"><Logo variant="seal" width={200} /></div>
    <p class="kicker" data-i18n="home.join.label">Get involved</p>
    <h2 class="section-title" id="joinband-title">
      <span data-i18n="home.join.title_1">Let's build a stronger 1st Ward</span>
      <span class="accent" data-i18n="home.join.title_2">together.</span>
    </h2>
    <p class="section-lede" data-i18n="home.join.lede">Sign a petition, knock a few doors, put up a yard sign, or tell a neighbor in English or Spanish. Every bit of help counts.</p>
    <div class="jb-ctas">
      <a href={`${base}/join/#signup`} class="btn btn-gold btn-massive" data-i18n="home.join.cta_join">Join the team</a>
      {canDonate() && <a href={donateHref(base)} class="btn btn-outline-light" data-i18n="home.join.cta_donate" {...ext}>Chip in</a>}
    </div>
    <ShareBar variant="dark" class="jb-share" />
  </div>
  <Swoosh class="jb-swoosh jb-swoosh-bottom" flip />
</section>

<style>
  .join-band { position: relative; overflow: hidden; padding: var(--space-5xl) 0 calc(var(--space-4xl) + 40px); }
  .join-band :global(.jb-swoosh) { position: absolute; left: -5%; width: 110%; height: clamp(40px, 6vw, 80px); pointer-events: none; }
  .join-band :global(.jb-swoosh-top) { top: var(--space-lg); }
  .join-band :global(.jb-swoosh-bottom) { bottom: var(--space-lg); opacity: 0.7; }
  .jb-inner { position: relative; z-index: 1; }
  .jb-inner .section-title { font-size: var(--text-5xl); display: flex; flex-wrap: wrap; column-gap: 0.25em; max-width: 16ch; }
  .jb-ctas { display: flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-xl); }
  .jb-inner :global(.jb-share) { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--line-light); }
  /* 120px minimum: the rim lettering stops reading below that */
  .jb-seal { width: 128px; margin-bottom: var(--space-lg); }
  .jb-seal :global(img) { width: 100%; height: auto; }
  @media (min-width: 1024px) {
    .jb-seal { position: absolute; top: 84px; right: calc(var(--gutter) + 32px); width: 200px; margin: 0; }
    /* keep the heading clear of the seal (the Spanish lines run longer) */
    .jb-inner .section-title { max-width: min(16ch, 100% - 330px); }
  }
  @media (max-width: 768px) {
    .join-band { padding: var(--space-4xl) 0; }
  }
</style>
