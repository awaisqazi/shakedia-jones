---
// Sticky bottom bar on phones and tablets: the standing asks. Hidden on /links/ via Layout's actionBar prop.
import { donateHref, isExternalDonate, canDonate } from '../data/campaign.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ext = isExternalDonate() ? { target: '_blank', rel: 'noopener' } : {};
---

<div class="action-bar hide-desktop" id="action-bar">
  <a href={`${base}/join/#signup`} class="bar-btn bar-volunteer" data-i18n="bar.volunteer">Volunteer</a>
  {canDonate()
    ? <a href={donateHref(base)} class="bar-btn bar-donate" data-i18n="bar.donate" {...ext}>Donate</a>
    : <button type="button" class="bar-btn bar-donate" data-i18n="bar.share" data-bar-share>Tell a neighbor</button>}
</div>

<script>
  // Until donations open, the second button is a share action: native share where it exists,
  // otherwise it scrolls to the page's share bar (or texts a neighbor as a last resort).
  const btn = document.querySelector<HTMLButtonElement>('[data-bar-share]');
  btn?.addEventListener('click', () => {
    const native = document.querySelector<HTMLButtonElement>('[data-share-native]:not([hidden])');
    if (native) { native.click(); return; }
    // First share bar that is actually shown (the one in /join/'s sign-up thank-you panel is hidden until a submit)
    const bar = [...document.querySelectorAll<HTMLElement>('[data-share-bar]')].find((b) => b.getClientRects().length > 0);
    if (bar) {
      bar.scrollIntoView({ behavior: 'smooth', block: 'center' });
      bar.querySelector<HTMLElement>('a, button:not([hidden])')?.focus({ preventScroll: true });
      return;
    }
    const sms = document.querySelector<HTMLAnchorElement>('.sb-sms');
    if (sms) location.href = sms.href;
  });
</script>

<style>
  .action-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 9990;
    display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(43, 7, 71, 0.96); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-top: 2px solid var(--gold);
  }
  .bar-btn {
    flex: 1; border: 2px solid transparent; font-family: var(--font-label); text-align: center; font-weight: 700; font-size: 1.05rem;
    text-transform: uppercase; letter-spacing: 0.08em; padding: 11px 10px 10px; border-radius: 999px;
  }
  .bar-btn:focus-visible { outline-color: var(--gold); }
  .bar-volunteer { background: var(--gold); color: var(--purple-deep); }
  .bar-donate { background: transparent; color: var(--white); border-color: rgba(255, 255, 255, 0.7); }
  @media (max-width: 400px) { .bar-btn { font-size: 0.92rem; letter-spacing: 0.04em; padding-inline: 6px; white-space: nowrap; } }
  @media (max-width: 1024px) { :global(body) { padding-bottom: 74px; } }
  /* At 200% zoom on a short screen the two fixed bars would eat a third of the viewport */
  @media (max-height: 500px) { .action-bar { position: static; } :global(body) { padding-bottom: 0; } }
</style>
