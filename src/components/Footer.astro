---
import Wordmark from './ui/Wordmark.astro';
import { EMAIL, SOCIALS, donateHref, isExternalDonate, canDonate } from '../data/campaign.js';
import en from '../i18n/parts/shared.en.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const DONATE = donateHref(base);
const ext = isExternalDonate() ? { target: '_blank', rel: 'noopener' } : {};
const socials = SOCIALS.filter((s) => s.href);
---

<footer class="site-footer on-dark" id="footer">
  <div class="footer-main">
    <div class="container footer-grid">
      <div class="footer-brand">
        <Wordmark light size="lg" />
        <p class="footer-motto" data-i18n="footer.motto">Excellence from Waukegan.</p>
        {EMAIL && <a href={`mailto:${EMAIL}`} class="footer-contact">{EMAIL}</a>}
      </div>

      <div class="footer-links">
        <h2 class="footer-h" data-i18n="footer.links_title">Explore</h2>
        <ul>
          <li><a href={`${base}/`} data-i18n="nav.home">Home</a></li>
          <li><a href={`${base}/meet/`} data-i18n="nav.meet">Meet Shakedia</a></li>
          <li><a href={`${base}/plan/`} data-i18n="nav.plan">The Game Plan</a></li>
          <li><a href={`${base}/join/`} data-i18n="nav.join">Get Involved</a></li>
          {canDonate() && <li><a href={DONATE} data-i18n="nav.donate" {...ext}>Donate</a></li>}
        </ul>
      </div>

      <div class="footer-dates">
        <h2 class="footer-h" data-i18n="footer.dates_title">Key dates</h2>
        <ul>
          {[1, 2, 3].map((n) => (
            <li><span class:list={['date-when', { 'date-big': n === 2 }]} data-i18n={`footer.when_${n}`}>{en.footer[`when_${n}`]}</span><span data-i18n={`footer.date_${n}`}>{en.footer[`date_${n}`]}</span></li>
          ))}
        </ul>
      </div>

      <div class="footer-social">
        <h2 class="footer-h" data-i18n="footer.follow_title">Follow</h2>
        {socials.length ? (
          <div class="social-icons">
            {socials.map((s) => (
              <a href={s.href} class="social-link" aria-label={s.name} target="_blank" rel="noopener">
                {s.icon === 'ig' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>}
                {s.icon === 'fb' && <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>}
                {s.icon === 'tt' && <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.23 8.23 0 0 0 4.76 1.51V6.82a4.83 4.83 0 0 1-1-.13z"/></svg>}
              </a>
            ))}
          </div>
        ) : (
          <p class="social-soon" data-i18n="footer.social_soon">Campaign social pages are on the way.</p>
        )}
        <a href={`${base}/links/`} class="footer-mini-link" data-i18n="footer.links_page">All links</a>
      </div>
    </div>

    <div class="container footer-legal">
      <p class="paid-for" data-i18n="footer.paid_for">Paid for by [Committee Name]</p>
      <!-- The statutory English notice stays visible in both languages; the Spanish line is added under it. -->
      <p class="disclosure" lang="en">A copy of our report filed with the State Board of Elections is (or will be) available on the Board's official website (www.elections.il.gov) or for purchase from the State Board of Elections, Springfield, Illinois.</p>
      <p class="disclosure disclosure-es" lang="es" data-i18n="footer.disclosure"></p>
      <p class="copyright" data-i18n="footer.copyright">© 2026 Shakedia Jones for Waukegan. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: rgba(255, 255, 255, 0.86); }

  .footer-main { padding: var(--space-3xl) 0 var(--space-xl); }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1.1fr; gap: var(--space-2xl); }
  .footer-motto { margin-top: var(--space-md); font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--text-xl); color: var(--gold); line-height: 1.05; }
  .footer-contact { display: block; margin-top: var(--space-sm); color: var(--white); font-weight: 600; font-size: var(--text-base); }
  .footer-contact:hover { color: var(--gold); text-decoration: underline; }
  .footer-h { font-family: var(--font-label); font-size: var(--text-sm); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: var(--space-md); font-weight: 700; }
  .footer-links li { margin-bottom: var(--space-sm); }
  .footer-links a { color: var(--white); font-weight: 500; transition: color var(--duration-fast); }
  .footer-links a:hover { color: var(--gold); }
  .footer-dates li { display: flex; flex-direction: column; margin-bottom: var(--space-md); font-size: var(--text-sm); }
  .date-when { font-weight: 700; color: var(--white); font-variant-numeric: tabular-nums; }
  .date-big { font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); color: var(--gold); text-transform: uppercase; line-height: 1.05; }
  .social-icons { display: flex; gap: var(--space-sm); }
  .social-link { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); color: var(--white); transition: background var(--duration-fast), transform var(--duration-fast); }
  .social-link:hover { background: var(--track); transform: translateY(-2px); }
  .social-soon { font-size: var(--text-sm); color: rgba(255, 255, 255, 0.72); }
  .footer-mini-link { display: inline-block; margin-top: var(--space-md); color: var(--gold); font-weight: 600; font-size: var(--text-sm); text-decoration: underline; text-underline-offset: 3px; }

  .footer-legal { margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid var(--line-light); text-align: center; }
  .paid-for { font-family: var(--font-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: var(--text-sm); color: var(--white); border: 1px solid rgba(255, 255, 255, 0.35); display: inline-block; padding: 5px 14px; border-radius: 4px; max-width: none; }
  .disclosure { font-size: 0.78rem; color: rgba(255, 255, 255, 0.62); max-width: 720px; margin: var(--space-md) auto; line-height: 1.5; }
  .disclosure-es:empty { display: none; }
  .copyright { font-size: 0.78rem; color: rgba(255, 255, 255, 0.55); max-width: none; }

  @media (max-width: 960px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>
