---
// The four priority icons from the flyer (car, buildings, home, people), drawn as simple
// 24px stroke SVGs. Decorative: place inside .icon-badge, which sets the color and size.
export interface Props { name: 'car' | 'buildings' | 'home' | 'people' }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'car' && (
    <>
      <path d="M4 16.5V12.8l1.9-4.3A2 2 0 0 1 7.7 7.3h8.6a2 2 0 0 1 1.8 1.2l1.9 4.3v3.7Z" />
      <path d="M4.2 12.8h15.6" />
      <path d="M6 16.5v2M18 16.5v2" />
      <circle cx="7.6" cy="14.6" r="0.6" fill="currentColor" />
      <circle cx="16.4" cy="14.6" r="0.6" fill="currentColor" />
    </>
  )}
  {name === 'buildings' && (
    <>
      <path d="M3 20.5h18" />
      <path d="M5 20.5V7.5l6.5-3v16" />
      <path d="M11.5 20.5v-11H19v11" />
      <path d="M8 9.5h.01M8 12.5h.01M8 15.5h.01M14.5 12.5h1.5M14.5 15.5h1.5" />
    </>
  )}
  {name === 'home' && (
    <>
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5.5 9.6V20h13V9.6" />
      <path d="M10 20v-5.2h4V20" />
    </>
  )}
  {name === 'people' && (
    <>
      <circle cx="12" cy="7.4" r="2.6" />
      <path d="M7.4 19.5v-1.6a4.6 4.6 0 0 1 9.2 0v1.6" />
      <circle cx="5.4" cy="10" r="1.9" />
      <circle cx="18.6" cy="10" r="1.9" />
      <path d="M2.6 19.5v-.9a3 3 0 0 1 3.9-2.9M21.4 19.5v-.9a3 3 0 0 0-3.9-2.9" />
    </>
  )}
</svg>
