---
// An approved quote on purple-deep. The quote stays in English in both languages (lang="en");
// Spanish readers get a labeled translation line (empty, and hidden, in English).
import Swoosh from '../ui/Swoosh.astro';
import en from '../../i18n/parts/plan.en.json';
const t = en.plan.quote;
---

<section class="plan-quote section-padding bg-purple-deep">
  <div class="container quote-inner">
    <p class="kicker animate-in" data-i18n="plan.quote.label">{t.label}</p>
    <figure class="animate-in">
      <blockquote lang="en">
        <span class="qmark" aria-hidden="true">&ldquo;</span>
        <p class="quote-text" data-i18n="plan.quote.text">{t.text}</p>
      </blockquote>
      <p class="tr-line" lang="es" data-i18n="plan.quote.quote_tr">{t.quote_tr}</p>
      <figcaption class="quote-cite" data-i18n="plan.quote.cite">{t.cite}</figcaption>
    </figure>
    <Swoosh class="quote-swoosh" />
    <p class="quote-context animate-in" data-i18n="plan.quote.context">{t.context}</p>
  </div>
</section>

<style>
  .plan-quote { position: relative; overflow: hidden; }
  .plan-quote::after {
    /* a faint gold star watermark */
    content: ''; position: absolute; right: -60px; bottom: -80px; width: 380px; height: 380px; pointer-events: none;
    background: rgba(254, 198, 10, 0.08); -webkit-mask: var(--star-mask) center / contain no-repeat; mask: var(--star-mask) center / contain no-repeat;
  }
  .quote-inner { position: relative; z-index: 1; max-width: 960px; }
  .qmark { display: block; font-family: var(--font-display); font-weight: 900; font-size: 7rem; line-height: 0.6; color: var(--gold); height: 0.5em; }
  .quote-text { font-size: var(--text-4xl); line-height: 1.12; max-width: 24ch; overflow-wrap: break-word; }
  .tr-line { margin-top: var(--space-md); font-size: var(--text-lg); font-style: italic; color: rgba(255, 255, 255, 0.85); max-width: 60ch; }
  .tr-line:empty { display: none; }
  .quote-cite { margin-top: var(--space-lg); font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--text-sm); color: var(--gold); }
  .plan-quote :global(.quote-swoosh) { max-width: 360px; height: 24px; margin: var(--space-xl) 0 var(--space-md); }
  .quote-context { font-size: var(--text-lg); color: rgba(255, 255, 255, 0.85); max-width: 60ch; }
  @media (max-width: 600px) {
    .qmark { font-size: 5rem; }
    .plan-quote::after { width: 240px; height: 240px; right: -60px; bottom: -60px; }
  }
</style>
