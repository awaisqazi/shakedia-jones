---
// Priority 4 aside: her record with young people (facts section wording only) and a youth outing photo.
// FLY is a 501(c)(3) and separate from the campaign, so the box carries a separation note.
// No District 60 job or events here, and no donation ask anywhere near this photo.
import en from '../../i18n/parts/plan.en.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const P = en.plan.p.p4;
const items = ['record_1', 'record_2'] as const;
---

<div class="record">
  <h4 class="record-label" data-i18n="plan.p.p4.record_label">{P.record_label}</h4>
  <ul>
    {items.map((key) => (
      <li>
        <svg class="check" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span data-i18n={`plan.p.p4.${key}`}>{P[key]}</span>
      </li>
    ))}
  </ul>
  <p class="record-note" data-i18n="plan.p.p4.record_note">{P.record_note}</p>
</div>

<figure class="photo record-photo">
  <img
    src={`${base}/images/fly-youth-outing-2026.webp`}
    width="1800" height="1350" loading="lazy" decoding="async"
    alt={P.photo_alt} data-i18n-attr="alt:plan.p.p4.photo_alt"
  />
  <figcaption data-i18n="plan.p.p4.photo_caption">{P.photo_caption}</figcaption>
</figure>

<style>
  .record { background: var(--green-soft); border-left: 6px solid var(--green); border-radius: var(--radius-md); padding: var(--space-lg); }
  .record-label {
    font-family: var(--font-label); font-weight: 700; font-size: var(--text-sm); text-transform: uppercase;
    letter-spacing: 0.18em; color: var(--green); margin-bottom: var(--space-md); line-height: 1.2;
  }
  .record ul { display: flex; flex-direction: column; gap: var(--space-sm); }
  .record li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-sm); color: var(--ink); font-weight: 500; font-size: var(--text-sm); line-height: 1.5; }
  .check { width: 18px; height: 18px; margin-top: 0.15em; color: var(--green); }
  .record-note { margin-top: var(--space-md); font-size: var(--text-xs); line-height: 1.5; color: var(--ink-soft); }
  .record-photo { margin-top: var(--space-lg); }
  .record-photo img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; height: auto; }
</style>
