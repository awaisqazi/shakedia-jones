---
// Closing call to action: send readers to /join/, plus the share bar. The Donate button renders
// only once DONATE_URL is set (no solicitation before the committee exists).
import ShareBar from '../ui/ShareBar.astro';
import en from '../../i18n/parts/plan.en.json';
import { canDonate, donateHref, isExternalDonate } from '../../data/campaign.js';

const t = en.plan.cta;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const DONATE = donateHref(base);
const ext = isExternalDonate() ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="plan-cta section-padding">
  <div class="container cta-inner">
    <div class="gold-rule cta-rule" aria-hidden="true"></div>
    <p class="kicker animate-in" data-i18n="plan.cta.label">{t.label}</p>
    <h2 class="section-title animate-in">
      <span data-i18n="plan.cta.title_1">{t.title_1}</span>
      <span class="accent" data-i18n="plan.cta.title_2">{t.title_2}</span>
    </h2>
    <p class="section-lede animate-in" data-i18n="plan.cta.text">{t.text}</p>
    <div class="cta-buttons animate-in">
      <a href={`${base}/join/`} class="btn btn-primary btn-massive" data-i18n="plan.cta.join">{t.join}</a>
      {canDonate() && (
        <a href={DONATE} class="btn btn-outline btn-massive" data-i18n="plan.cta.donate" {...ext}>{t.donate}</a>
      )}
    </div>
    <ShareBar class="cta-share" />
  </div>
</section>

<style>
  .plan-cta { background: var(--cream); }
  .cta-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cta-rule { width: min(320px, 100%); margin-bottom: var(--space-xl); }
  .section-title span:first-child { display: block; }
  .plan-cta :global(.sb-row) { justify-content: center; }
  .section-title { overflow-wrap: break-word; }
  .section-lede { margin-inline: auto; }
  .cta-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); margin-top: var(--space-lg); }
  .plan-cta :global(.cta-share) { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--lilac); width: 100%; }
  @media (max-width: 480px) {
    .cta-buttons { flex-direction: column; width: 100%; }
    .cta-buttons .btn { width: 100%; }
  }
</style>
