---
// Meet hero: royal purple field with a sunset glow and the skyline along the bottom edge,
// a Playfair headline in her own words, gold-ring credential pills and the dedication-day
// photo in a gold frame.
import Star from '../ui/Star.astro';
import Swoosh from '../ui/Swoosh.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="meet-hero bg-purple" aria-labelledby="meet-hero-title">
  <div class="hero-glow" aria-hidden="true"></div>
  <img class="hero-skyline" src={`${base}/images/campaign/skyline.webp`} width="1300" height="150" alt="" aria-hidden="true" loading="eager" decoding="async" />

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker animate-in" data-i18n="meet.hero.kicker">Meet Shakedia</p>
      <h1 id="meet-hero-title" class="hero-title animate-in" style="--reveal-delay: 0.06s">
        <span class="t-line" data-i18n="meet.hero.title_1">Born and raised in the 1st Ward.</span>
        <span class="t-line accent" data-i18n="meet.hero.title_2">Back to serve it.</span>
      </h1>
      <Swoosh class="hero-swoosh animate-in" />
      <p class="section-lede animate-in" style="--reveal-delay: 0.12s" data-i18n="meet.hero.lede">Shakedia Jones was born and raised in the 1st Ward of Waukegan. She won 17 individual state titles, graduated from Waukegan High in 1997, ran for UCLA and Team USA, and came home to build Furthering the Lives of Youth (FLY). Now she is running for 1st Ward Alderman.</p>

      <ul class="hero-tags animate-in" style="--reveal-delay: 0.18s" aria-label="Highlights" data-i18n-attr="aria-label:meet.hero.tags_label">
        <li class="tag"><Star class="tag-star" /><span data-i18n="meet.hero.tag_1">USA Olympian</span></li>
        <li class="tag"><Star class="tag-star" /><span data-i18n="meet.hero.tag_2">17-time Illinois state champion</span></li>
        <li class="tag tag-fly"><Star class="tag-star" /><span data-i18n="meet.hero.tag_3">Founder of FLY</span></li>
        <li class="tag"><Star class="tag-star" /><span data-i18n="meet.hero.tag_4">Has coached WHS girls track</span></li>
      </ul>

      <div class="hero-ctas animate-in" style="--reveal-delay: 0.24s">
        <a href="#story" class="btn btn-primary" data-i18n="meet.hero.cta_story">Read her story</a>
        <a href={`${base}/plan/`} class="btn btn-outline" data-i18n="meet.hero.cta_plan">Her priorities</a>
      </div>
    </div>

    <div class="hero-media animate-in" style="--reveal-delay: 0.1s">
      <figure class="hero-frame">
        <div class="hero-photo">
          <img
            src={`${base}/images/olympic-way-sign-portrait.webp`}
            width="440" height="1100"
            alt="Two women under the George Avenue street sign and the Shakedia Jones Olympic Way honorary sign, one pointing up at it."
            data-i18n-attr="alt:meet.hero.photo_alt"
            loading="eager" fetchpriority="high" decoding="async"
          />
        </div>
        <figcaption data-i18n="meet.hero.photo_cap">Dedication day on George Avenue, July 14, 2024.</figcaption>
      </figure>
      <div class="hero-plate">
        <Star class="plate-star" />
        <span class="plate-text">
          <span class="plate-label" data-i18n="meet.hero.plate_label">Hometown</span>
          <span class="plate-value" data-i18n="meet.hero.plate_value">Waukegan, IL</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .meet-hero {
    position: relative; overflow: hidden; isolation: isolate;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 calc(var(--space-4xl) + 40px);
  }
  /* The flyers' sky: a sunset glow rising from the bottom edge, under the skyline */
  .hero-glow {
    position: absolute; inset: auto 0 0 0; height: 46%; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(74, 3, 117, 0) 0%, rgba(138, 42, 143, 0.55) 45%, rgba(224, 69, 123, 0.75) 72%, rgba(255, 154, 60, 0.85) 90%, #fec60a 100%);
  }
  .hero-skyline {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); z-index: -1;
    width: max(100%, 1300px); max-width: none; height: auto; opacity: 0.55; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 70%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 70%);
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: var(--space-3xl); align-items: center; }
  .hero-copy { min-width: 0; }
  .hero-title { font-size: clamp(2.5rem, 1.6rem + 3.9vw, 5rem); line-height: 0.98; margin-bottom: var(--space-md); }
  .t-line { display: block; }
  :global(.hero-swoosh) { max-width: 360px; height: 26px; margin-bottom: var(--space-lg); }
  .hero-copy .section-lede { color: rgba(255, 255, 255, 0.9); }

  .hero-tags { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin: var(--space-xl) 0; }
  .tag {
    display: inline-flex; align-items: center; gap: 0.5em;
    font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    font-size: var(--text-sm); line-height: 1.2; padding: 0.5em 1em 0.45em 0.8em;
    border: 2px solid var(--gold); border-radius: 999px; color: var(--white);
    background: rgba(43, 7, 71, 0.55);
  }
  .tag-fly { background: var(--green); }
  .tag :global(.tag-star) { width: 0.95em; height: 0.95em; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: var(--space-md); }

  /* Dedication photo in a gold frame */
  .hero-media { position: relative; justify-self: center; width: min(100%, 360px); }
  .hero-frame {
    position: relative; padding: 10px; border-radius: var(--radius-xl);
    background: var(--gold-sheen); box-shadow: var(--shadow-xl), 0 0 0 1px rgba(254, 198, 10, 0.4);
    transform: rotate(1.2deg);
  }
  .hero-photo { border-radius: calc(var(--radius-xl) - 8px) calc(var(--radius-xl) - 8px) 0 0; overflow: hidden; width: 100%; height: clamp(440px, 52vw, 580px); background: var(--purple-deep); }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-frame figcaption {
    background: var(--purple-deep); color: var(--white);
    border-radius: 0 0 calc(var(--radius-xl) - 8px) calc(var(--radius-xl) - 8px);
    padding: 0.7rem 1rem; font-family: var(--font-label); font-weight: 600; font-size: var(--text-sm); letter-spacing: 0.04em; line-height: 1.35;
  }
  .hero-plate {
    position: absolute; left: -28px; top: 14%;
    display: flex; align-items: center; gap: 0.6rem;
    background: var(--purple-deep); color: var(--white); border-radius: 999px; padding: 0.5rem 1.1rem 0.5rem 0.6rem;
    box-shadow: 0 0 0 2px var(--gold), var(--shadow-lg);
  }
  .hero-plate :global(.plate-star) { width: 1.6rem; height: 1.6rem; }
  .plate-text { display: flex; flex-direction: column; gap: 1px; }
  .plate-label { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.72rem; color: var(--gold); line-height: 1.1; }
  .plate-value { font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; line-height: 1.05; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
    .hero-media { width: min(100%, 320px); }
    .hero-photo { height: 500px; }
  }
  @media (max-width: 480px) {
    .meet-hero { padding-top: calc(var(--nav-height) + var(--space-2xl)); }
    .hero-title { font-size: clamp(2.1rem, 10.5vw, 2.8rem); }
    .hero-plate { left: -6px; }
    .hero-media { width: min(100%, 280px); }
    .hero-photo { height: 440px; }
    .hero-ctas .btn { flex: 1 1 100%; }
    .tag { white-space: normal; }
  }
</style>
