---
// In the news: three outside sources, newest first. Headlines stay in English (they are the outlets' own titles).
// The errata note sits under the list because some older articles repeat claims the record above does not make.
---

<section class="meet-news section-padding" aria-labelledby="news-title">
  <div class="container">
    <div class="news-head">
      <div>
        <p class="section-label"><span class="kick-bar" aria-hidden="true"></span><span data-i18n="meet.news.kicker">In the news</span></p>
        <h2 id="news-title" class="section-title">
          <span data-i18n="meet.news.title_1">Read it</span>
          <span class="accent" data-i18n="meet.news.title_2">from the press box</span>
        </h2>
      </div>
      <div class="news-intro">
        <p class="section-lede" data-i18n="meet.news.lede">Coverage of her career and of FLY.</p>
        <p class="news-note" data-i18n="meet.news.note">Links open in a new tab.</p>
      </div>
    </div>

    <ol class="news-list">
      <li class="news-item animate-in" style="--reveal-delay: 0.00s">
        <a href="https://www.chicagotribune.com/2024/08/08/former-waukegan-olympian-shakedia-jones-honored-by-city-how-proud-this-community-is-of-you/" class="news-link" target="_blank" rel="noopener">
          <span class="news-chip" aria-hidden="true">1</span>
          <span class="news-meta"><span class="news-src" data-i18n="meet.news.n1_src">Lake County News-Sun</span><span class="news-date" data-i18n="meet.news.n1_date">August 8, 2024</span></span>
          <span class="news-title" lang="en" data-i18n="meet.news.n1_title">Former Waukegan Olympian Shakedia Jones honored by city</span>
          <span class="visually-hidden" data-i18n="meet.news.newtab">(opens in a new tab)</span>
          <svg class="news-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </li>
      <li class="news-item animate-in" style="--reveal-delay: 0.04s">
        <a href="https://www.chicagotribune.com/2016/06/20/former-waukegan-ucla-track-star-shakedia-jones-helping-youth-excel/" class="news-link" target="_blank" rel="noopener">
          <span class="news-chip" aria-hidden="true">2</span>
          <span class="news-meta"><span class="news-src" data-i18n="meet.news.n2_src">Chicago Tribune</span><span class="news-date" data-i18n="meet.news.n2_date">June 20, 2016</span></span>
          <span class="news-title" lang="en" data-i18n="meet.news.n2_title">Former Waukegan, UCLA track star Shakedia Jones helping youth excel</span>
          <span class="visually-hidden" data-i18n="meet.news.newtab">(opens in a new tab)</span>
          <svg class="news-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </li>
      <li class="news-item animate-in" style="--reveal-delay: 0.08s">
        <a href="https://uclabruins.com/sports/2013/4/17/208196576" class="news-link" target="_blank" rel="noopener">
          <span class="news-chip" aria-hidden="true">3</span>
          <span class="news-meta"><span class="news-src" data-i18n="meet.news.n3_src">UCLA Athletics</span><span class="news-date" data-i18n="meet.news.n3_date">Player bio</span></span>
          <span class="news-title" lang="en" data-i18n="meet.news.n3_title">Shakedia Jones, UCLA track and field</span>
          <span class="visually-hidden" data-i18n="meet.news.newtab">(opens in a new tab)</span>
          <svg class="news-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </li>
    </ol>
    <p class="news-errata" data-i18n="meet.news.errata">Some older articles contain errors; the record above reflects official IHSA, UCLA and World Athletics results.</p>
  </div>
</section>

<style>
  .kick-bar { display: inline-block; width: 34px; height: 4px; background: var(--track); border-radius: 2px; }
  .news-head { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: end; margin-bottom: var(--space-xl); }
  .news-intro .section-lede { margin-bottom: var(--space-sm); }
  .news-note { font-family: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--text-sm); color: var(--muted); }

  .news-list { border-top: 3px solid var(--navy); }
  .news-item { border-bottom: 1px solid var(--line); }
  .news-link {
    display: grid; grid-template-columns: 2.4rem minmax(0, 15rem) minmax(0, 1fr) auto; gap: var(--space-lg); align-items: center;
    padding: var(--space-lg) var(--space-sm); transition: background var(--duration-fast), padding var(--duration-normal) var(--ease-default);
  }
  .news-link:hover, .news-link:focus-visible { background: var(--white); padding-left: var(--space-md); }
  .news-chip {
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border: 2px solid var(--track); border-radius: 4px;
    font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; color: var(--track); line-height: 1;
  }
  .news-meta { display: flex; flex-direction: column; line-height: 1.25; }
  .news-src { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--text-sm); color: var(--navy); }
  .news-date { font-size: var(--text-sm); color: var(--muted); font-variant-numeric: tabular-nums; }
  .news-title { font-weight: 600; font-size: var(--text-lg); color: var(--ink); line-height: 1.3; overflow-wrap: anywhere; }
  .news-link:hover .news-title { color: var(--track-deep); }
  .news-errata { margin-top: var(--space-md); max-width: 70ch; font-size: var(--text-sm); color: var(--muted); line-height: 1.5; }
  .news-arrow { color: var(--track); transition: transform var(--duration-normal) var(--ease-default); }
  .news-link:hover .news-arrow { transform: translate(3px, -3px); }

  @media (max-width: 860px) {
    .news-head { grid-template-columns: 1fr; gap: var(--space-md); }
    .news-link { grid-template-columns: 2.4rem minmax(0, 1fr) auto; gap: var(--space-xs) var(--space-md); }
    .news-chip { grid-row: span 2; align-self: start; }
    .news-meta { flex-direction: row; flex-wrap: wrap; gap: 0 0.6em; grid-column: 2; }
    .news-title { grid-column: 2; }
    .news-arrow { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
