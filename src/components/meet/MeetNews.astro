---
// In the news: three outside sources, newest first. Headlines stay in English (they are the outlets' own titles).
// The errata note sits under the list because some older articles repeat claims the record above does not make.
const items = [
  { n: 1, href: 'https://www.chicagotribune.com/2024/08/08/former-waukegan-olympian-shakedia-jones-honored-by-city-how-proud-this-community-is-of-you/', src: 'Lake County News-Sun', date: 'August 8, 2024', title: 'Former Waukegan Olympian Shakedia Jones honored by city' },
  { n: 2, href: 'https://www.chicagotribune.com/2016/06/20/former-waukegan-ucla-track-star-shakedia-jones-helping-youth-excel/', src: 'Chicago Tribune', date: 'June 20, 2016', title: 'Former Waukegan, UCLA track star Shakedia Jones helping youth excel' },
  { n: 3, href: 'https://uclabruins.com/sports/2013/4/17/208196576', src: 'UCLA Athletics', date: 'Player bio', title: 'Shakedia Jones, UCLA track and field' },
];
---

<section class="meet-news section-padding" aria-labelledby="news-title">
  <div class="container">
    <div class="news-head">
      <div>
        <p class="kicker" data-i18n="meet.news.kicker">In the news</p>
        <h2 id="news-title" class="section-title">
          <span data-i18n="meet.news.title_1">Read about her</span>
          <span class="accent" data-i18n="meet.news.title_2">in the press</span>
        </h2>
      </div>
      <div class="news-intro">
        <p class="section-lede" data-i18n="meet.news.lede">Coverage of her career and of FLY.</p>
        <p class="news-note" data-i18n="meet.news.note">Links open in a new tab.</p>
      </div>
    </div>

    <ul class="news-list">
      {items.map((it, i) => (
        <li class="news-item animate-in" style={`--reveal-delay: ${(i * 0.05).toFixed(2)}s`}>
          <a href={it.href} class="news-link card-gold" target="_blank" rel="noopener">
            <span class="news-meta">
              <span class="news-src" data-i18n={`meet.news.n${it.n}_src`}>{it.src}</span>
              <span class="news-date" data-i18n={`meet.news.n${it.n}_date`}>{it.date}</span>
            </span>
            <span class="news-title" lang="en" data-i18n={`meet.news.n${it.n}_title`}>{it.title}</span>
            <span class="visually-hidden" data-i18n="meet.news.newtab">(opens in a new tab)</span>
            <span class="news-go icon-badge icon-badge-sm" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="news-errata" data-i18n="meet.news.errata">Some older articles contain errors. The outdoor, college and international record above reflects official IHSA, UCLA and World Athletics results; the indoor state titles are as reported by the campaign.</p>
  </div>
</section>

<style>
  .news-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: end; margin-bottom: var(--space-xl); }
  .news-intro .section-lede { margin-bottom: var(--space-sm); }
  .news-note { font-family: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--text-sm); color: var(--muted); }

  .news-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
  .news-item { display: flex; }
  .news-link {
    position: relative; display: flex; flex-direction: column; gap: var(--space-md); width: 100%;
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    transition: transform var(--duration-normal) var(--ease-default), box-shadow var(--duration-normal);
  }
  .news-link:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); }
  .news-meta { display: flex; flex-direction: column; line-height: 1.25; padding-right: 3.5rem; }
  .news-src { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--text-sm); color: var(--purple); }
  .news-date { font-size: var(--text-sm); color: var(--muted); font-variant-numeric: lining-nums tabular-nums; }
  .news-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); color: var(--purple-deep); line-height: 1.2; overflow-wrap: anywhere; font-variant-numeric: lining-nums; }
  .news-go { position: absolute; top: var(--space-lg); right: var(--space-lg); --badge-size: 40px; transition: transform var(--duration-normal) var(--ease-default); }
  .news-link:hover .news-go { transform: translate(2px, -2px); }
  .news-errata { margin-top: var(--space-lg); max-width: 70ch; font-size: var(--text-sm); color: var(--muted); line-height: 1.5; }

  @media (max-width: 960px) {
    .news-list { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 860px) {
    .news-head { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
  }
</style>
