---
// Her story in five chapters on a gold hairline, each chapter marked by a gold star.
import Star from '../ui/Star.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/images/${f}`;
---

<section id="story" class="story section-padding" aria-labelledby="story-title">
  <div class="container">
    <header class="story-head">
      <p class="kicker" data-i18n="meet.story.kicker">Her story</p>
      <h2 id="story-title" class="section-title">
        <span class="t-line" data-i18n="meet.story.title_1">From George Avenue</span>
        <span class="accent" data-i18n="meet.story.title_2">to Sydney, and home again</span>
      </h2>
      <p class="section-lede" data-i18n="meet.story.lede">A girl from the neighborhood, a cousin who believed in her, and a city that cheered her on. Here is how Shakedia got from the 1st Ward to the world, and why she came back.</p>
    </header>

    <ol class="chapters">
      <!-- 1. Growing up -->
      <li class="chapter" aria-labelledby="ch1-title">
        <div class="marker" aria-hidden="true"><span class="marker-dot"><Star class="marker-star" /></span></div>
        <div class="ch-body">
          <div class="ch-text animate-in">
            <p class="ch-when"><span class="ch-num"><span data-i18n="meet.story.chapter">Chapter</span> 1</span><span class="sep" aria-hidden="true"></span><span data-i18n="meet.story.c1_when">Waukegan, the early years</span></p>
            <h3 id="ch1-title" class="ch-title" data-i18n="meet.story.c1_title">Growing up in Waukegan</h3>
            <p data-i18n="meet.story.c1_p1">Shakedia Jones was born and raised in the 1st Ward of Waukegan, on what she calls the South Side. Growing up, money was tight.</p>
            <blockquote class="ch-quote">
              <p class="q-text" lang="en" data-i18n="meet.story.c1_quote">My mom didn't have the money to pay for me to participate in any organized sports until I got to high school.</p>
              <p class="tr-line" lang="es"><span class="tr-label" data-i18n="meet.story.tr_label">Translation</span> <span data-i18n="meet.story.c1_quote_tr">Mi mamá no tenía dinero para pagarme ningún deporte organizado hasta que llegué a la preparatoria.</span></p>
            </blockquote>
            <p data-i18n="meet.story.c1_p2">Then her cousin Shannon King, himself a Gatorade Illinois Player of the Year, talked her into going out for track. She called him "my angel."</p>
          </div>
          <aside class="ch-aside animate-in" style="--reveal-delay: 0.08s">
            <div class="card-gold schools">
              <h4 class="aside-title" data-i18n="meet.story.c1_schools">Her neighborhood schools</h4>
              <ul class="star-list">
                <li data-i18n="meet.story.c1_s1">Carman (now Carman-Buckner)</li>
                <li data-i18n="meet.story.c1_s2">Glen Flora Elementary</li>
                <li data-i18n="meet.story.c1_s3">North Elementary</li>
                <li data-i18n="meet.story.c1_s4">Jack Benny Middle School</li>
                <li class="school-end" data-i18n="meet.story.c1_s5">Waukegan High School</li>
              </ul>
            </div>
          </aside>
        </div>
      </li>

      <!-- 2. High school champion -->
      <li class="chapter" aria-labelledby="ch2-title">
        <div class="marker" aria-hidden="true"><span class="marker-dot"><Star class="marker-star" /></span></div>
        <div class="ch-body">
          <div class="ch-text animate-in">
            <p class="ch-when"><span class="ch-num"><span data-i18n="meet.story.chapter">Chapter</span> 2</span><span class="sep" aria-hidden="true"></span><span data-i18n="meet.story.c2_when">High school, Class of 1997</span></p>
            <h3 id="ch2-title" class="ch-title" data-i18n="meet.story.c2_title">High school champion</h3>
            <p data-i18n="meet.story.c2_p1">In high school she won the IHSA state title in the 100m and the 200m all four years, plus the 400m in 1996. When she graduated from Waukegan High in 1997, nine was the most in Illinois girls' track history.</p>
            <p data-i18n="meet.story.c2_p2">She was named Gatorade Illinois Girls Track &amp; Field Player of the Year twice, in 1996 and 1997, and the Chicago Tribune's 1997 prep athlete of the year.</p>
            <blockquote class="ch-quote ch-quote-big">
              <p class="q-text" lang="en" data-i18n="meet.story.c2_quote">Speed was my gift.</p>
              <p class="tr-line" lang="es"><span class="tr-label" data-i18n="meet.story.tr_label">Translation</span> <span data-i18n="meet.story.c2_quote_tr">La velocidad era mi don.</span></p>
              <footer class="q-src" data-i18n="meet.story.c2_quote_src">VoyageChicago, 2018</footer>
            </blockquote>
          </div>
          <aside class="ch-aside animate-in" style="--reveal-delay: 0.08s">
            <div class="titles">
              <h4 class="titles-title" data-i18n="meet.story.table_title">IHSA state titles</h4>
              <table class="titles-table">
                <thead>
                  <tr>
                    <th scope="col" data-i18n="meet.story.table_event">Event</th>
                    <th scope="col" class="num" data-i18n="meet.story.table_titles">Titles</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row"><span class="ev">100m</span><span class="ev-note" data-i18n="meet.story.table_r1">All four years</span></th>
                    <td class="num"><span class="stars" aria-hidden="true"><Star /><Star /><Star /><Star /></span><span class="stat-tabular">4</span></td>
                  </tr>
                  <tr>
                    <th scope="row"><span class="ev">200m</span><span class="ev-note" data-i18n="meet.story.table_r2">All four years</span></th>
                    <td class="num"><span class="stars" aria-hidden="true"><Star /><Star /><Star /><Star /></span><span class="stat-tabular">4</span></td>
                  </tr>
                  <tr>
                    <th scope="row"><span class="ev">400m</span><span class="ev-note" data-i18n="meet.story.table_r3">1996</span></th>
                    <td class="num"><span class="stars" aria-hidden="true"><Star /></span><span class="stat-tabular">1</span></td>
                  </tr>
                </tbody>
                <tfoot>
                  <tr>
                    <th scope="row" data-i18n="meet.story.table_total">Total</th>
                    <td class="num total stat-tabular">9</td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </aside>
        </div>
      </li>

      <!-- 3. Team USA and UCLA -->
      <li class="chapter" aria-labelledby="ch3-title">
        <div class="marker" aria-hidden="true"><span class="marker-dot"><Star class="marker-star" /></span></div>
        <div class="ch-body">
          <div class="ch-text animate-in">
            <p class="ch-when"><span class="ch-num"><span data-i18n="meet.story.chapter">Chapter</span> 3</span><span class="sep" aria-hidden="true"></span><span data-i18n="meet.story.c3_when">1998 to 2001</span></p>
            <h3 id="ch3-title" class="ch-title" data-i18n="meet.story.c3_title">Team USA and UCLA</h3>
            <p data-i18n="meet.story.c3_p1">In 1998 she wore USA colors at the World Junior Championships in Annecy, France: gold in the 100m, gold in the 4x100m relay with an American junior record, and silver in the 200m.</p>
            <p data-i18n="meet.story.c3_p2">At UCLA from 1998 to 2001 she was the 1998 Pac-10 champion in the 100m and the 4x100m relay, a two-time NCAA team champion (2000 and 2001 indoor), a two-time NCAA runner-up in the 100m and a multiple-time All-American.</p>
            <p data-i18n="meet.story.c3_p3">In 2000 she was named to the U.S. Olympic Team for Sydney, in the 4x100m relay pool. She earned a B.A. in Sociology at UCLA, competed professionally after college, and later earned an MBA from Keller Graduate School of Management.</p>
          </div>
          <aside class="ch-aside ucla-aside animate-in" style="--reveal-delay: 0.08s">
            <figure class="photo ucla-photo">
              <img src={img('ucla-cap.webp')} width="675" height="900" alt="A smiling selfie in a UCLA cap." data-i18n-attr="alt:meet.story.c3_photo_alt" loading="lazy" decoding="async" />
              <figcaption data-i18n="meet.story.c3_photo_cap">Still a Bruin.</figcaption>
            </figure>
            <div class="pbs card-gold">
              <p class="pbs-title" data-i18n="meet.story.c3_pb">Personal bests</p>
              <div class="pbs-row">
                <span class="pb"><span class="pb-ev" data-i18n="meet.story.c3_pb_100">100m</span><span class="pb-time stat-tabular">11.11</span></span>
                <span class="pb"><span class="pb-ev" data-i18n="meet.story.c3_pb_200">200m</span><span class="pb-time stat-tabular">22.84</span></span>
              </div>
            </div>
          </aside>
        </div>
      </li>

      <!-- 4. Home for good: FLY (biography only), work and coaching -->
      <li class="chapter chapter-fly" aria-labelledby="ch4-title">
        <div class="marker" aria-hidden="true"><span class="marker-dot"><Star class="marker-star" /></span></div>
        <div class="ch-body">
          <div class="ch-text animate-in">
            <p class="ch-when"><span class="ch-num"><span data-i18n="meet.story.chapter">Chapter</span> 4</span><span class="sep" aria-hidden="true"></span><span data-i18n="meet.story.c4_when">2013 to today</span></p>
            <h3 id="ch4-title" class="ch-title" data-i18n="meet.story.c4_title">Home for good</h3>
            <div class="ch-paras">
              <p data-i18n="meet.story.c4_p1">She came home to Waukegan for good in 2013. In 2014 she founded Furthering the Lives of Youth (FLY), an IRS-recognized 501(c)(3) with a simple mission: "assisting exceptional youth with limited resources."</p>
              <p data-i18n="meet.story.c4_p2">Young people are nominated and need a 3.2 GPA. FLY has paid volleyball and track fees, bought equipment, bought a first cello for a young Waukegan cellist, sponsored a youth track club team and community track meets, paid for trips (including to Los Angeles), sponsored community trips to Chicago Sky games and co-hosted a backpack giveaway. More than 600 young people helped, by her 2024 count. She says she has helped 20 young people earn athletic scholarships.</p>
              <p data-i18n="meet.story.c4_p3">She works for Waukegan Public Schools (District 60) as Family and Community Engagement Manager and has coached girls track at Waukegan High School. Titles are for identification only; the district does not endorse candidates.</p>
            </div>
            <ul class="roles">
              <li class="role role-fly" data-i18n="meet.story.c4_role_1">Founder, FLY, 2014</li>
              <li class="role" data-i18n="meet.story.c4_role_2">Has coached WHS girls track</li>
            </ul>
          </div>
          <aside class="ch-aside fly-media animate-in" style="--reveal-delay: 0.08s">
            <figure class="photo fly-photo">
              <img src={img('fly-park-day-2017.webp')} width="1600" height="1200" alt="Young people and adults in FLY shirts at a park event." data-i18n-attr="alt:meet.story.c4_photo_alt" loading="lazy" decoding="async" />
              <figcaption data-i18n="meet.story.c4_photo_cap">FLY in the park, summer 2017.</figcaption>
            </figure>
            <p class="fly-note" data-i18n="meet.story.c4_fly_note">Furthering the Lives of Youth is a nonprofit organization. It is separate from this campaign and does not endorse candidates.</p>
          </aside>
        </div>
      </li>

      <!-- 5. Running for the 1st Ward -->
      <li class="chapter chapter-now" aria-labelledby="ch5-title">
        <div class="marker" aria-hidden="true"><span class="marker-dot"><Star class="marker-star" /></span></div>
        <div class="ch-body ch-body-stack">
          <div class="now-card bg-purple animate-in">
            <p class="ch-when"><span class="ch-num"><span data-i18n="meet.story.chapter">Chapter</span> 5</span><span class="sep" aria-hidden="true"></span><span data-i18n="meet.story.c5_when">Primary election: February 23, 2027</span></p>
            <h3 id="ch5-title" class="ch-title" data-i18n="meet.story.c5_title">Running for the 1st Ward</h3>
            <p data-i18n="meet.story.c5_p1">Now she is running for 1st Ward Alderman, in the neighborhood that raised her.</p>
            <p data-i18n="meet.story.c5_p2">She will bring the habits she has kept her whole life: set the goal, make a plan, do the work, and report back to her neighbors.</p>
            <div class="now-foot">
              <p class="now-general" data-i18n="meet.story.c5_general">General election: April 6, 2027</p>
              <a href={`${base}/plan/`} class="arrow-link" data-i18n="meet.story.c5_link">See her priorities</a>
            </div>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .story { --marker: 56px; }
  .story-head { margin-bottom: var(--space-3xl); max-width: 860px; }

  /* The gold hairline that strings the chapters together */
  .t-line { display: block; }
  .chapters { --ch-gap: var(--space-4xl); position: relative; display: flex; flex-direction: column; gap: var(--ch-gap); }
  .chapter:not(:last-child)::before {
    content: ''; position: absolute; left: calc(var(--marker) / 2 - 1px); top: 12px; height: calc(100% + var(--ch-gap)); width: 2px;
    background: var(--gold);
  }
  .chapter { position: relative; display: grid; grid-template-columns: var(--marker) minmax(0, 1fr); gap: var(--space-2xl); }
  .marker { position: relative; }
  .marker-dot {
    position: sticky; top: calc(var(--nav-height) + 20px);
    display: grid; place-items: center; width: var(--marker); height: var(--marker); border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--purple-3), var(--purple) 55%, var(--purple-deep));
    box-shadow: 0 0 0 3px var(--gold), 0 0 0 7px var(--cream), var(--shadow-md);
  }
  .marker-dot :global(.marker-star) { width: 54%; height: 54%; }
  .chapter-fly .marker-dot { background: radial-gradient(circle at 35% 30%, #13805a, var(--green) 60%, #063826); }

  .ch-body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--space-2xl); align-items: start; min-width: 0; }
  .ch-body-stack { grid-template-columns: minmax(0, 1fr); }
  .ch-text { min-width: 0; }
  .ch-text > p + p, .ch-paras p + p, .now-card > p + p { margin-top: var(--space-md); }
  .story .ch-when {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.2em 0.5em;
    font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--text-sm);
    color: var(--gold-deep); margin-bottom: var(--space-sm); padding-top: 0.6rem;
  }
  .sep { width: 18px; height: 2px; background: currentColor; opacity: 0.6; }
  .chapter-fly .ch-when { color: var(--green); }
  .ch-title { font-family: var(--font-display); font-weight: 800; font-size: var(--text-3xl); color: var(--purple); line-height: 1.08; margin-bottom: var(--space-lg); }
  .ch-text p { color: var(--ink-soft); }

  .ch-quote { margin: var(--space-lg) 0; padding: var(--space-sm) 0 var(--space-sm) var(--space-lg); border-left: 4px solid var(--gold); }
  .ch-text .ch-quote .q-text { font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: var(--text-xl); color: var(--purple-deep); line-height: 1.35; }
  .ch-quote .q-text::before { content: '\201C'; }
  .ch-quote .q-text::after { content: '\201D'; }
  .ch-text .ch-quote-big .q-text { font-weight: 800; font-size: var(--text-4xl); line-height: 1.02; color: var(--purple); }
  .ch-text .q-src { margin-top: var(--space-sm); font-family: var(--font-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: var(--text-xs); color: var(--muted); }
  .ch-text .tr-line { margin-top: var(--space-xs); font-size: var(--text-sm); color: var(--muted); }
  .tr-label { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.78em; color: var(--purple-deep); }
  :global(html[lang='en']) .tr-line { display: none; }

  /* Chapter 1: schools */
  .ch-aside { min-width: 0; }
  .schools { padding: var(--space-lg) var(--space-xl) var(--space-xl); }
  .aside-title { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: var(--text-sm); color: var(--purple); margin-bottom: var(--space-md); }
  .schools li { font-weight: 600; color: var(--purple-deep); line-height: 1.35; }
  .schools .school-end { font-family: var(--font-display); font-weight: 800; font-size: var(--text-xl); color: var(--purple); }

  /* Chapter 2: titles table on purple */
  .titles { background: var(--purple); color: var(--white); border-radius: var(--radius-lg); padding: var(--space-lg) var(--space-xl); box-shadow: var(--shadow-lg); border-top: 6px solid var(--gold); }
  .titles-title { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--text-sm); color: var(--gold); margin-bottom: var(--space-sm); }
  .titles-table { width: 100%; border-collapse: collapse; }
  .titles-table th, .titles-table td { text-align: left; padding: 0.7rem 0; border-bottom: 1px solid var(--line-light); vertical-align: middle; }
  .titles-table thead th { font-family: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--text-xs); color: rgba(255, 255, 255, 0.72); padding-top: 0; }
  .titles-table .num { text-align: right; }
  .titles-table tbody th { font-weight: 400; }
  .ev { display: block; font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); line-height: 1; font-variant-numeric: lining-nums; }
  .ev-note { display: block; font-size: var(--text-xs); color: rgba(255, 255, 255, 0.75); margin-top: 3px; }
  .titles-table td { font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); color: var(--gold); white-space: nowrap; font-variant-numeric: lining-nums tabular-nums; }
  .stars { display: inline-flex; gap: 2px; margin-right: 0.5rem; vertical-align: 0.1em; font-size: 0.6em; }
  .titles-table tfoot th, .titles-table tfoot td { border-bottom: 0; padding-bottom: 0; }
  .titles-table tfoot th { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--text-sm); color: var(--white); }
  .titles-table .total { font-size: var(--text-4xl); line-height: 0.95; }

  /* Chapter 3: small photo + personal bests */
  .ucla-aside { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: var(--space-md); align-items: end; }
  .ucla-photo { aspect-ratio: 3 / 4; box-shadow: var(--shadow-md); }
  .pbs { padding: var(--space-md) var(--space-lg) var(--space-lg); }
  .pbs-title { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--text-xs); color: var(--purple); margin-bottom: var(--space-sm); }
  .pbs-row { display: grid; gap: var(--space-sm); }
  .pb { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); }
  .pb + .pb { border-top: 1px solid var(--lilac); padding-top: var(--space-sm); }
  .pb-ev { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--text-sm); color: var(--muted); }
  .pb-time { font-family: var(--font-display); font-weight: 900; font-size: var(--text-3xl); color: var(--purple); line-height: 1; font-variant-numeric: lining-nums tabular-nums; }

  /* Chapter 4: FLY */
  .roles { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin: var(--space-xl) 0 0; }
  .role {
    font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--text-sm);
    padding: 0.45em 1em 0.4em; border-radius: 999px; background: var(--purple); color: var(--white); line-height: 1.2;
    box-shadow: 0 0 0 2px var(--gold);
  }
  .role-fly { background: var(--green); }
  .fly-media { display: flex; flex-direction: column; gap: var(--space-md); padding-top: 3.2rem; }
  .fly-photo { aspect-ratio: 4 / 3; box-shadow: var(--shadow-md); }
  .fly-note { font-size: var(--text-sm); line-height: 1.5; color: var(--muted); border-left: 3px solid var(--green); padding-left: var(--space-md); }

  /* Chapter 5: now */
  .now-card { border-radius: var(--radius-xl); padding: var(--space-2xl); border-top: 6px solid var(--gold); box-shadow: var(--shadow-lg); }
  .now-card .ch-when { color: var(--gold); }
  .now-card .ch-title { color: var(--white); font-size: var(--text-4xl); }
  .now-card p { color: rgba(255, 255, 255, 0.88); }
  .now-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md) var(--space-lg); margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--line-light); }
  .now-card .now-general { font-family: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--text-sm); color: rgba(255, 255, 255, 0.8); }

  @media (max-width: 860px) {
    .story { --marker: 44px; }
    .chapter { gap: var(--space-lg); }
    .chapters { --ch-gap: var(--space-3xl); }
    .ch-body { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .ucla-aside { max-width: 480px; }
    .fly-media { padding-top: 0; max-width: 560px; }
  }
  @media (max-width: 560px) {
    .story { --marker: 34px; }
    .chapter { gap: var(--space-md); }
    .marker-dot { box-shadow: 0 0 0 2px var(--gold), 0 0 0 5px var(--cream), var(--shadow-sm); }
    .story .ch-when { flex-direction: column; align-items: flex-start; padding-top: 0.2rem; letter-spacing: 0.12em; }
    .sep { display: none; }
    .now-card { padding: var(--space-lg); }
    .now-card .ch-title { font-size: var(--text-3xl); }
    .titles { padding: var(--space-md) var(--space-lg); }
    .schools { padding: var(--space-md) var(--space-lg) var(--space-lg); }
    .ch-text .ch-quote-big .q-text { font-size: var(--text-3xl); }
  }
  @media (max-width: 400px) {
    .ucla-aside { grid-template-columns: minmax(0, 1fr); }
    .ucla-photo { max-width: 220px; }
  }
</style>
