---
// Pull quote: "make it your Olympics". Typographic: a big gold quote mark on royal purple,
// framed by gold swooshes.
import Swoosh from '../ui/Swoosh.astro';
---

<section class="meet-quote bg-purple" aria-labelledby="quote-kicker">
  <div class="container quote-wrap animate-in">
    <p id="quote-kicker" class="kicker" data-i18n="meet.quote.kicker">In her words</p>
    <blockquote class="big-quote">
      <span class="q-mark" aria-hidden="true">&ldquo;</span>
      <p class="q-text" lang="en" data-i18n="meet.quote.text">I tell them whatever it is you do, make it your Olympics.</p>
      <p class="tr-line" lang="es"><span class="tr-label" data-i18n="meet.quote.tr_label">Translation</span> <span data-i18n="meet.quote.tr">Les digo que, sea lo que sea que hagan, lo conviertan en sus Olimpiadas.</span></p>
      <footer class="q-src" data-i18n="meet.quote.src">Shakedia Jones, Chicago Tribune, 2016</footer>
    </blockquote>
    <Swoosh class="quote-swoosh" />
  </div>
</section>

<style>
  .meet-quote {
    position: relative; overflow: hidden; padding: var(--space-4xl) 0;
    background:
      radial-gradient(ellipse 60% 70% at 50% 110%, rgba(224, 69, 123, 0.35), transparent 70%),
      radial-gradient(circle at 12% 20%, rgba(254, 198, 10, 0.1), transparent 40%),
      var(--purple);
  }
  .quote-wrap { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .big-quote { position: relative; max-width: 980px; padding-top: 3.2rem; }
  .q-mark {
    position: absolute; left: 50%; top: -0.15em; transform: translateX(-50%);
    font-family: var(--font-display); font-weight: 900; font-size: 9rem; line-height: 1; color: var(--gold);
    pointer-events: none;
  }
  .big-quote .q-text {
    font-family: var(--font-display); font-weight: 800; font-style: italic; letter-spacing: -0.01em;
    font-size: var(--text-5xl); line-height: 1.02; color: var(--white); max-width: 22ch; margin-inline: auto;
    font-variant-numeric: lining-nums; text-wrap: balance;
  }
  .tr-line { margin: var(--space-lg) auto 0; font-size: var(--text-base); color: rgba(255, 255, 255, 0.82); max-width: 60ch; }
  .tr-label { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.78em; color: var(--gold); margin-right: 0.3em; }
  :global(html[lang='en']) .tr-line { display: none; }
  .q-src { margin-top: var(--space-xl); font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--text-sm); color: var(--gold); }
  :global(.quote-swoosh) { max-width: 420px; height: 30px; margin-top: var(--space-lg); }

  @media (max-width: 860px) {
    .meet-quote { padding: var(--space-3xl) 0; }
    .big-quote .q-text { font-size: var(--text-4xl); }
    .q-mark { font-size: 7rem; }
    .big-quote { padding-top: 2.6rem; }
  }
  @media (max-width: 480px) {
    .big-quote .q-text { font-size: clamp(1.8rem, 8.5vw, 2.3rem); }
  }
</style>
