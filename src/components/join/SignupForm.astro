---
// Volunteer sign-up (/join/#signup; other pages link here, keep the id). A native form that posts
// into the campaign's "Volunteer Sign-Up" Google Form: field names and option values come from
// FORMS.volunteer in src/data/campaign.js and must match the Google Form exactly (values stay in
// English in both languages; only labels are translated). Behavior: src/scripts/forms.js.
// English fallbacks are read from join.en.json so the HTML always matches the dictionary.
import { FORMS, FORM_STATIC_FIELDS } from '../../data/campaign.js';
import en from '../../i18n/parts/join.en.json';
import ShareBar from '../ui/ShareBar.astro';
import Logo from '../ui/Logo.astro';

const F = FORMS.volunteer;
const E = F.entries;
const v = en.join.volunteer as Record<string, string>;
const f = en.join.forms as Record<string, string>;
const otherName = `${E.events}${F.otherSuffix}`;
const msgKeys = ['err_name', 'err_email', 'err_email_shape', 'err_phone', 'err_avail', 'err_other', 'err_summary', 'err_network', 'busy'];
const weekend = [
  { k: 'sat', legend: 'sat_legend', slots: F.availability.saturday },
  { k: 'sun', legend: 'sun_legend', slots: F.availability.sunday },
];
---

<section class="section-padding sf" id="signup" aria-labelledby="sf-title">
  <div class="container sf-grid">
    <header class="sf-head">
      <p class="kicker animate-in" data-i18n="join.volunteer.label">{v.label}</p>
      <h2 class="section-title animate-in" id="sf-title">
        <span data-i18n="join.volunteer.title_a">{v.title_a}</span>
        <span class="accent" data-i18n="join.volunteer.title_b">{v.title_b}</span>
      </h2>
      <p class="section-lede animate-in" data-i18n="join.volunteer.lede">{v.lede}</p>
      <div class="sf-how animate-in">
        <h3 class="sf-how-title" data-i18n="join.volunteer.next_title">{v.next_title}</h3>
        <ul class="star-list sf-steps">
          <li data-i18n="join.volunteer.next_1">{v.next_1}</li>
          <li data-i18n="join.volunteer.next_2">{v.next_2}</li>
          <li data-i18n="join.volunteer.next_3">{v.next_3}</li>
        </ul>
      </div>
    </header>

    <div class="sf-card card-gold animate-in" data-form-card>
      <h3 class="card-gold-head sf-card-title" data-i18n="join.volunteer.card_title">{v.card_title}</h3>

      <form class="fm-form" id="volunteer-form" data-gform method="POST" action={F.action} target="_blank" accept-charset="UTF-8" aria-labelledby="sf-title">
        {Object.entries(FORM_STATIC_FIELDS).map(([k, val]) => <input type="hidden" name={k} value={val} />)}

        <div class="fm-field" data-field data-msg="err_name" data-error="vf-name-err">
          <label class="fm-label" for="vf-name"><span data-i18n="join.volunteer.name_label">{v.name_label}</span> <span class="fm-req" data-i18n="join.forms.required">{f.required}</span></label>
          <input class="fm-input" id="vf-name" name={E.name} type="text" autocomplete="name" required />
          <p class="fm-error" id="vf-name-err" hidden></p>
        </div>

        <div class="fm-row">
          <div class="fm-field" data-field data-msg="err_email" data-error="vf-email-err">
            <label class="fm-label" for="vf-email"><span data-i18n="join.volunteer.email_label">{v.email_label}</span> <span class="fm-req" data-i18n="join.forms.required">{f.required}</span></label>
            <input class="fm-input" id="vf-email" name={F.email} type="email" autocomplete="email" inputmode="email" spellcheck="false" autocapitalize="off" required />
            <p class="fm-error" id="vf-email-err" hidden></p>
          </div>
          <div class="fm-field" data-field data-msg="err_phone" data-error="vf-phone-err">
            <label class="fm-label" for="vf-phone"><span data-i18n="join.volunteer.phone_label">{v.phone_label}</span> <span class="fm-req" data-i18n="join.forms.required">{f.required}</span></label>
            <input class="fm-input" id="vf-phone" name={E.phone} type="tel" autocomplete="tel" inputmode="tel" required />
            <p class="fm-error" id="vf-phone-err" hidden></p>
          </div>
        </div>

        <fieldset class="fm-set" aria-describedby="vf-events-hint">
          <legend><span data-i18n="join.volunteer.events_legend">{v.events_legend}</span> <span class="fm-opt" data-i18n="join.forms.optional">{f.optional}</span></legend>
          <p class="fm-hint" id="vf-events-hint" data-i18n="join.volunteer.events_hint">{v.events_hint}</p>
          <div class="chip-grid">
            {F.events.map((o) => (
              <label class="chip">
                <input type="checkbox" name={E.events} value={o.value} />
                <span class="chip-box" aria-hidden="true"></span>
                <span class="chip-text" data-i18n={`join.volunteer.ev_${o.k}`}>{v[`ev_${o.k}`]}</span>
              </label>
            ))}
            <label class="chip">
              <input type="checkbox" name={E.events} value={F.otherValue} data-other="vf-other-wrap" aria-controls="vf-other-wrap" />
              <span class="chip-box" aria-hidden="true"></span>
              <span class="chip-text" data-i18n="join.volunteer.ev_other">{v.ev_other}</span>
            </label>
          </div>
          <div class="fm-field sf-other" id="vf-other-wrap" data-field data-msg="err_other" data-error="vf-other-err">
            <label class="fm-label" for="vf-other"><span data-i18n="join.volunteer.other_label">{v.other_label}</span> <span class="fm-req" data-i18n="join.forms.required">{f.required}</span></label>
            <input class="fm-input" id="vf-other" name={otherName} type="text" autocomplete="off" data-required />
            <p class="fm-error" id="vf-other-err" hidden></p>
          </div>
        </fieldset>

        <fieldset class="fm-set sf-avail" data-field data-group data-msg="err_avail" data-error="vf-avail-err">
          <legend><span data-i18n="join.volunteer.avail_legend">{v.avail_legend}</span> <span class="fm-req" data-i18n="join.forms.required">{f.required}</span></legend>
          <p class="fm-hint" data-i18n="join.volunteer.avail_hint">{v.avail_hint}</p>
          <p class="fm-error" id="vf-avail-err" hidden></p>
          <div class="sf-schedule">
            <fieldset class="sf-day sf-weekdays" id="vf-weekdays">
              <legend data-i18n="join.volunteer.weekday_legend">{v.weekday_legend}</legend>
              <div class="chip-grid sf-days">
                {F.availability.weekday.map((o) => (
                  <label class="chip chip-day">
                    <input type="checkbox" name={E.availability} value={o.value} />
                    <span class="chip-box" aria-hidden="true"></span>
                    <span class="chip-text" aria-hidden="true" data-i18n={`join.volunteer.day_${o.k}`}>{v[`day_${o.k}`]}</span>
                    <span class="visually-hidden" data-i18n={`join.volunteer.day_${o.k}_full`}>{v[`day_${o.k}_full`]}</span>
                  </label>
                ))}
              </div>
              <button type="button" class="fm-linkbtn" data-select-all="vf-weekdays" hidden data-i18n="join.volunteer.select_weekdays">{v.select_weekdays}</button>
            </fieldset>
            {weekend.map((d) => (
              <fieldset class="sf-day">
                <legend data-i18n={`join.volunteer.${d.legend}`}>{v[d.legend]}</legend>
                <div class="chip-grid sf-slots">
                  {d.slots.map((o) => (
                    <label class="chip">
                      <input type="checkbox" name={E.availability} value={o.value} />
                      <span class="chip-box" aria-hidden="true"></span>
                      <span class="chip-text" data-i18n={`join.volunteer.slot_${o.k}`}>{v[`slot_${o.k}`]}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
        </fieldset>

        <div class="fm-field">
          <label class="fm-label" for="vf-others"><span data-i18n="join.volunteer.others_label">{v.others_label}</span> <span class="fm-opt" data-i18n="join.forms.optional">{f.optional}</span></label>
          <p class="fm-hint" id="vf-others-hint" data-i18n="join.volunteer.others_hint">{v.others_hint}</p>
          <input class="fm-input" id="vf-others" name={E.others} type="text" autocomplete="off" aria-describedby="vf-others-hint" />
        </div>

        <fieldset class="fm-set">
          <legend><span data-i18n="join.volunteer.heard_legend">{v.heard_legend}</span> <span class="fm-opt" data-i18n="join.forms.optional">{f.optional}</span></legend>
          <div class="chip-grid sf-heard">
            {F.heard.map((o) => (
              <label class="chip">
                <input type="radio" name={E.heard} value={o.value} />
                <span class="chip-box" aria-hidden="true"></span>
                <span class="chip-text" data-i18n={`join.volunteer.heard_${o.k}`}>{v[`heard_${o.k}`]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Decoy for bots: no name, so it is never sent to Google -->
        <div class="fm-hp" aria-hidden="true">
          <label for="vf-hp">Leave this field empty</label>
          <input id="vf-hp" type="text" tabindex="-1" autocomplete="off" data-honeypot />
        </div>

        <p class="fm-status" data-status role="alert" hidden></p>
        <button type="submit" class="btn btn-primary btn-massive fm-submit"><span data-btn-label data-i18n="join.volunteer.submit">{v.submit}</span></button>
        <noscript><p class="fm-hint" data-i18n="join.forms.nojs_note">{f.nojs_note}</p></noscript>
      </form>

      <div class="fm-success" data-success hidden>
        <Logo variant="seal" width={136} />
        <h3 class="fm-success-title" tabindex="-1" data-success-title data-i18n="join.volunteer.thanks_title">{v.thanks_title}</h3>
        <p class="script" data-i18n="ui.slogan">Building a Stronger 1st Ward Together</p>
        <p data-i18n="join.volunteer.thanks_text">{v.thanks_text}</p>
        <div class="sf-next">
          <h4 class="sf-next-title" data-i18n="join.volunteer.thanks_share">{v.thanks_share}</h4>
          <ShareBar class="sf-share" compact />
        </div>
        <button type="button" class="btn btn-outline fm-again" data-again data-i18n="join.forms.again">{f.again}</button>
      </div>

      <p class="visually-hidden" data-live aria-live="polite"></p>
      <div data-msgs hidden>
        {msgKeys.map((k) => <span data-msg={k} data-i18n={`join.forms.${k}`}>{f[k]}</span>)}
      </div>
    </div>
  </div>
</section>

<script>
  import { initForms } from '../../scripts/forms.js';
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initForms);
  else initForms();
</script>

<style>
  #signup { scroll-margin-top: calc(var(--nav-height) + var(--space-md)); }
  .sf-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr); gap: var(--space-3xl); align-items: start; }
  .sf-head { position: sticky; top: calc(var(--nav-height) + var(--space-lg)); }
  .sf-how { margin-top: var(--space-xl); padding: var(--space-lg); border-left: 5px solid var(--gold); background: var(--white); border-radius: 0 var(--radius-md) var(--radius-md) 0; box-shadow: var(--shadow-sm); }
  .sf-how-title { font-family: var(--font-label); font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--purple); margin-bottom: var(--space-sm); }
  .sf-steps { color: var(--ink-soft); font-size: var(--text-base); }

  .sf-card-title { margin: 0; }
  .sf-other { padding: var(--space-md); background: var(--cream); border-radius: var(--radius-md); }

  .sf-schedule { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm) var(--space-md); }
  .sf-day { grid-column: span 1; border: none; margin: 0; min-width: 0; padding: var(--space-sm) var(--space-md) var(--space-md); background: var(--cream); border-radius: var(--radius-md); display: flex; flex-direction: column; gap: var(--space-sm); }
  .sf-weekdays { grid-column: 1 / -1; }
  .sf-day > legend {
    float: left; width: 100%; padding: 0; font-family: var(--font-label); font-weight: 700; font-size: 0.95rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--purple);
  }
  .sf-day > legend + * { clear: both; }
  .sf-days { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .sf-slots { grid-template-columns: 1fr; }
  .chip-day { justify-content: center; padding-inline: 0.5rem; gap: 8px; }
  .sf-heard { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .sf-next { width: 100%; margin-top: var(--space-sm); padding-top: var(--space-lg); border-top: 1px solid var(--lilac); display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
  .sf-next-title { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: var(--text-sm); color: var(--purple); }
  .sf-card :global(.sf-share .sb-row) { justify-content: center; }

  @media (max-width: 900px) {
    .sf-grid { grid-template-columns: 1fr; gap: var(--space-xl); }
    .sf-head { position: static; }
  }
  @media (max-width: 640px) {
    .sf-days { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .sf-schedule { grid-template-columns: 1fr; }
    .sf-slots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sf-day { padding-inline: var(--space-sm); }
  }
  /* Small phones: day chips stack the box over the short day name; slots and radios go one per row */
  @media (max-width: 420px) {
    .chip-day { flex-direction: column; gap: 4px; padding: 0.5rem 0.25rem; min-height: 64px; }
    .sf-slots, .sf-heard { grid-template-columns: 1fr; }
  }
</style>
