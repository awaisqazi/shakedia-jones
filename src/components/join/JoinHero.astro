---
// Get Involved hero: the flyers' sunset sky, a plain-language headline, the script slogan,
// a gold-topped card counting down to the primary, and the skyline strip along the bottom edge.
import RaceClock from '../ui/RaceClock.astro';
import Ribbon from '../ui/Ribbon.astro';
import { DATES, canDonate } from '../../data/campaign.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="jh bg-sunset" aria-labelledby="jh-title">
  <img class="jh-skyline" src={`${base}/images/campaign/skyline.webp`} width="1300" height="150" alt="" aria-hidden="true" decoding="async" />
  <div class="container jh-grid">
    <div class="jh-copy">
      <p class="kicker animate-in" data-i18n="join.hero.label">Get involved</p>
      <h1 class="jh-title animate-in" id="jh-title" style="--reveal-delay: 0.05s">
        <span data-i18n="join.hero.title_a">Join the</span>
        <span class="accent" data-i18n="join.hero.title_b">team.</span>
      </h1>
      <p class="jh-slogan script animate-in" style="--reveal-delay: 0.08s" data-i18n="ui.slogan">Building a Stronger 1st Ward Together</p>
      <p class="section-lede animate-in" style="--reveal-delay: 0.1s" data-i18n="join.hero.lede">Shakedia Jones is running for 1st Ward Alderman, and this campaign runs on neighbors. Carry a petition, talk with the people on your block, put a sign in your yard. Every bit of help makes the 1st Ward stronger.</p>
      <div class="jh-ctas animate-in" style="--reveal-delay: 0.15s">
        <a href="#signup" class="btn btn-primary btn-massive" data-i18n="join.hero.cta_signup">Join the team</a>
        <a href="#ways" class="btn btn-outline" data-i18n="join.hero.cta_ways">See ways to help</a>
        {canDonate() && <a href="#donate" class="btn btn-outline" data-i18n="join.hero.cta_donate">Chip in</a>}
      </div>
    </div>

    <aside class="jh-card card-gold animate-in" style="--reveal-delay: 0.2s" aria-labelledby="jh-card-title">
      <h2 class="card-gold-head jh-card-title" id="jh-card-title" data-i18n="join.hero.card_title">The primary</h2>
      <div class="jh-card-body">
        <RaceClock date={DATES.primary} labelKey="join.hero.clock_label" label="days until the primary" size="lg" />
        <p class="jh-date">
          <span class="jh-date-k" data-i18n="join.hero.date_label">Primary election</span>
          <span class="jh-date-v" data-i18n="join.hero.date_value">Tuesday, February 23, 2027</span>
        </p>
        <p class="jh-general">
          <span class="jh-general-k" data-i18n="join.hero.general_label">General election</span>
          <span class="jh-general-v" data-i18n="join.hero.general_value">Tuesday, April 6, 2027</span>
        </p>
        <div class="jh-now">
          <span class="jh-now-k" data-i18n="join.hero.now_label">How it starts</span>
          <p class="jh-now-v" data-i18n="join.hero.now_text">Petitions are how a candidate gets on the ballot. Volunteers help gather signatures from 1st Ward voters.</p>
        </div>
      </div>
    </aside>
  </div>
  <div class="container jh-ribbon-row animate-in">
    <Ribbon size="sm" />
  </div>
</section>

<style>
  .jh {
    position: relative; overflow: hidden; isolation: isolate;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 clamp(150px, 16vw, 220px);
  }
  .jh-skyline {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: -1;
    width: 100%; height: clamp(110px, 14vw, 190px); object-fit: cover; object-position: 50% 100%;
    opacity: 0.9;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 55%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 55%);
  }
  .jh-grid { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-3xl); align-items: center; }
  .jh-title { font-size: var(--text-5xl); line-height: 0.98; margin-bottom: var(--space-sm); color: var(--white); }
  .jh-slogan {
    font-size: clamp(1.45rem, 1.1rem + 1.6vw, 2.3rem); color: var(--gold); margin-bottom: var(--space-lg); max-width: none;
    text-shadow: 0 2px 10px rgba(29, 10, 46, 0.45);
  }
  .jh-copy .section-lede { color: rgba(255, 255, 255, 0.9); }
  .jh-ctas { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xl); align-items: center; }
  .jh-ctas .btn { min-height: 48px; }

  .jh-card { display: flex; flex-direction: column; }
  .jh-card-title { margin: 0; font-size: var(--text-2xl); }
  .jh-card-body { padding: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-md); align-items: flex-start; }
  .jh-date, .jh-general, .jh-now { display: flex; flex-direction: column; gap: 2px; max-width: none; }
  .jh-date-k, .jh-general-k, .jh-now-k {
    font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: var(--text-xs); color: var(--muted);
  }
  .jh-date-k { color: var(--gold-deep); }
  .jh-date-v { font-variant-numeric: lining-nums; font-family: var(--font-display); font-weight: 900; font-size: var(--text-2xl); color: var(--purple); line-height: 1.1; }
  .jh-general-v { font-weight: 600; color: var(--ink-soft); }
  .jh-now { width: 100%; padding-top: var(--space-md); border-top: 1px solid var(--lilac); }
  .jh-now-v { color: var(--ink-soft); font-size: var(--text-sm); }

  .jh-ribbon-row { position: relative; display: flex; justify-content: center; margin-top: var(--space-3xl); }

  @media (max-width: 900px) {
    .jh-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
    .jh-card { max-width: 520px; }
  }
  @media (max-width: 600px) {
    .jh { padding-top: calc(var(--nav-height) + var(--space-2xl)); }
    .jh-ctas .btn { width: 100%; white-space: normal; }
    .jh-card-body { padding: var(--space-lg); }
    .jh-ribbon-row { margin-top: var(--space-2xl); }
  }
</style>
