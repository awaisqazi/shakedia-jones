---
// Renders nothing until donations are open (DONATE_URL set): no solicitation before the committee exists.
import { DONATE_URL, canDonate } from '../../data/campaign.js';
const show = canDonate();
---

{show && (

<section class="section-padding bg-navy on-dark db" id="donate" aria-labelledby="db-title">
  <div class="container db-grid">
    <div class="db-copy">
      <span class="section-label animate-in"><span class="lane-chip" aria-hidden="true">4</span><span data-i18n="join.donate.label">Chip in</span></span>
      <h2 class="section-title animate-in" id="db-title">
        <span data-i18n="join.donate.title_a">Fuel the</span>
        <span class="accent" data-i18n="join.donate.title_b">anchor leg</span>
      </h2>
      <p class="section-lede animate-in" data-i18n="join.donate.lede">This campaign runs on neighbors, not big checks. Your gift pays for petition clipboards, flyers in Spanish and English, and yard signs for the 1st Ward.</p>
    </div>

    <div class="db-box animate-in">
      <a href={DONATE_URL} class="btn btn-gold btn-massive btn-block db-big" target="_blank" rel="noopener" data-i18n="join.donate.button">Donate now</a>
      <p class="db-small" data-i18n="join.donate.button_note">Opens our secure donation page in a new tab.</p>
      <p class="db-legal" data-i18n="join.donate.legal">Contributions to [Committee Name] are not tax deductible. Contributions over $150 are itemized in reports filed with the Illinois State Board of Elections. Contributions must be made from your own funds; contributions from foreign nationals are prohibited.</p>
    </div>
  </div>
</section>
)}

<style>
  #donate { scroll-margin-top: calc(var(--nav-height) + var(--space-md)); }
  .db-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-3xl); align-items: center; }
  .db-box {
    background: var(--navy-2); border: 1px solid var(--line-light); border-radius: var(--radius-lg);
    padding: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-md);
    box-shadow: inset 0 6px 0 var(--gold);
  }
  .db-big { min-height: 64px; white-space: normal; }
  .db-small { font-size: var(--text-sm); color: rgba(255, 255, 255, 0.7); }
  .db-act { min-height: 48px; }
  .db-legal { margin-top: var(--space-sm); padding-top: var(--space-md); border-top: 1px solid var(--line-light); font-size: var(--text-xs); color: rgba(255, 255, 255, 0.66); line-height: 1.5; }

  @media (max-width: 900px) { .db-grid { grid-template-columns: 1fr; gap: var(--space-xl); } }
  @media (max-width: 480px) {
    .db-box { padding: var(--space-lg); }
    .db-act { width: 100%; white-space: normal; }
  }
</style>
