---
// Renders nothing until donations are open (DONATE_URL set): no solicitation before the committee exists.
import { DONATE_URL, canDonate } from '../../data/campaign.js';
import Swoosh from '../ui/Swoosh.astro';
const show = canDonate();
---

{show && (

<section class="section-padding bg-purple-deep db" id="donate" aria-labelledby="db-title">
  <Swoosh class="db-swoosh" />
  <div class="container db-grid">
    <div class="db-copy">
      <p class="kicker animate-in" data-i18n="join.donate.label">Chip in</p>
      <h2 class="section-title animate-in" id="db-title">
        <span data-i18n="join.donate.title_a">Help build a</span>
        <span class="accent" data-i18n="join.donate.title_b">stronger 1st Ward</span>
      </h2>
      <p class="section-lede animate-in" data-i18n="join.donate.lede">This campaign runs on neighbors, not big checks. Your gift pays for petition clipboards, flyers in Spanish and English, and yard signs for the 1st Ward.</p>
    </div>

    <div class="db-box card-gold animate-in">
      <p class="card-gold-head" data-i18n="join.donate.box_title">Every gift counts</p>
      <div class="db-body">
        <a href={DONATE_URL} class="btn btn-primary btn-massive btn-block db-big" target="_blank" rel="noopener"><span data-i18n="join.donate.button">Donate now</span><span class="visually-hidden" data-i18n="ui.newtab">(opens in a new tab)</span></a>
        <p class="db-small" data-i18n="join.donate.button_note">Opens our secure donation page in a new tab.</p>
        <p class="db-legal" data-i18n="join.donate.legal">Contributions to Friends of Shakedia Jones are not tax deductible. Contributions over $150 are itemized in reports filed with the Illinois State Board of Elections. Contributions must be made from your own funds; contributions from foreign nationals are prohibited.</p>
      </div>
    </div>
  </div>
</section>
)}

<style>
  #donate { scroll-margin-top: calc(var(--nav-height) + var(--space-md)); }
  .db { position: relative; overflow: hidden; }
  .db :global(.db-swoosh) { position: absolute; top: 18px; left: -5%; width: 110%; height: 60px; opacity: 0.55; pointer-events: none; }
  .db-grid { position: relative; display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-3xl); align-items: center; }
  .db-body { padding: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-md); }
  .db-big { min-height: 64px; white-space: normal; }
  .db-small { font-size: var(--text-sm); color: var(--muted); }
  .db-legal { padding-top: var(--space-md); border-top: 1px solid var(--lilac); font-size: var(--text-xs); color: var(--ink-soft); line-height: 1.5; }

  @media (max-width: 900px) { .db-grid { grid-template-columns: 1fr; gap: var(--space-xl); } }
  @media (max-width: 480px) { .db-body { padding: var(--space-lg); } }
</style>
