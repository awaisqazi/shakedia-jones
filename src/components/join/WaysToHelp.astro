---
// Ways to help: gold-topped white cards on purple, each with a round icon badge (the flyers'
// priority icons). The "Give" card renders only once donations are open (canDonate):
// no solicitation before the committee exists.
import { canDonate } from '../../data/campaign.js';

const icons: Record<string, string> = {
  petition: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2.8h6V4"/><path d="M8.5 10h7M8.5 14h7M8.5 18h4"/>',
  doors: '<path d="M3 11l9-7 9 7"/><path d="M5 9.5V20h14V9.5"/><path d="M10 20v-6h4v6"/>',
  sign: '<rect x="3" y="4" width="18" height="10" rx="1.5"/><path d="M8 14v7M16 14v7"/><path d="M7.5 9h9"/>',
  events: '<circle cx="12" cy="8" r="3"/><circle cx="5" cy="10" r="2"/><circle cx="19" cy="10" r="2"/><path d="M6.5 20a5.5 5.5 0 0 1 11 0"/><path d="M2 19a3.5 3.5 0 0 1 4-3.4M22 19a3.5 3.5 0 0 0-4-3.4"/>',
  words: '<path d="M4 4h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M19 8h1a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1v3l-4-3h-3"/>',
  give: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>',
};

const allWays = [
  { k: 'petition', title: 'Sign and carry petitions', text: 'Petitions are how a candidate gets on the ballot, and volunteers help gather signatures from 1st Ward voters. Sign one, or gather signatures on your own block.', rules: 'Petition signers must be registered voters in the 1st Ward. Circulators must meet state eligibility rules; we will train you before you start.', cta: 'I can carry a petition', href: '#signup', hot: true },
  { k: 'doors', title: 'Knock doors, talk to neighbors', text: 'The best campaign is a neighbor on the porch. We give you a short list, a few talking points and a partner.', cta: 'Count me in', href: '#signup' },
  { k: 'sign', title: 'Host a yard sign', text: 'One sign in one window starts the conversation on a whole block. We drop it off.', cta: 'Request a sign', href: '#signup' },
  { k: 'events', title: 'Help at events', text: 'Set up tables, greet neighbors, hand out water at the park. Every event needs a crew.', cta: 'Join the crew', href: '#signup' },
  { k: 'words', title: 'Spread the word in Spanish and English', text: 'Share posts, translate a flyer, talk about the campaign with your neighbors, team or group chat, in whichever language they speak.', cta: 'I can help share', href: '#signup' },
  { k: 'give', title: 'Give', text: 'Any amount buys clipboards, flyers and yard signs. Small gifts from neighbors go the farthest.', cta: 'How to give', href: '#donate', donate: true },
];
const ways = allWays.filter((w) => !w.donate || canDonate());
const six = ways.length === 6;
---

<section class="section-padding bg-purple wth" id="ways" aria-labelledby="wth-title">
  <div class="wth-glow" aria-hidden="true"></div>
  <div class="container">
    <header class="wth-head">
      <p class="kicker animate-in" data-i18n="join.ways.label">Ways to help</p>
      <h2 class="section-title animate-in" id="wth-title">
        <span data-i18n={six ? 'join.ways.title_a' : 'join.ways.title_a_five'}>{six ? 'Six ways' : 'Five ways'}</span>
        <span class="accent" data-i18n="join.ways.title_b">to help</span>
      </h2>
      <p class="section-lede animate-in" data-i18n="join.ways.lede">Choose one, choose three, or tell us how much time you have and we will find the right fit.</p>
    </header>

    <ul class="wth-grid">
      {ways.map((w, i) => (
        <li class:list={['wth-card card-gold animate-in', `wth-${w.k}`, { hot: w.hot }]} style={`--reveal-delay: ${i * 0.05}s`}>
          <div class="wth-top">
            <span class="icon-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.k]} />
            </span>
            {w.hot && <span class="wth-tag" data-i18n="join.ways.start_tag">Start here</span>}
          </div>
          <h3 class="wth-title" data-i18n={`join.ways.${w.k}_title`}>{w.title}</h3>
          <p class="wth-text" data-i18n={`join.ways.${w.k}_text`}>{w.text}</p>
          {w.rules && <p class="wth-rules" data-i18n={`join.ways.${w.k}_rules`}>{w.rules}</p>}
          <a href={w.href} class="arrow-link wth-cta" data-i18n={`join.ways.${w.k}_cta`}>{w.cta}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wth { position: relative; overflow: hidden; isolation: isolate; }
  .wth-glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 50% at 85% 0%, rgba(254, 198, 10, 0.16), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgba(106, 31, 160, 0.55), transparent 70%);
  }
  .wth-head { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .wth-head .section-lede { margin-inline: auto; }

  .wth-grid { margin-top: var(--space-2xl); display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .wth-card { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); padding: var(--space-xl); }
  .wth-card.hot { grid-column: span 2; }
  .wth-give { grid-column: 1 / -1; }
  .wth-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); width: 100%; margin-bottom: var(--space-sm); }
  .wth-title { font-family: var(--font-display); font-weight: 800; font-size: var(--text-xl); line-height: 1.12; color: var(--purple); }
  .wth-text { color: var(--ink-soft); }
  .wth-rules {
    font-size: var(--text-sm); color: var(--ink); background: var(--gold-soft);
    border-left: 4px solid var(--gold); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.6rem 0.8rem; max-width: none;
  }
  .wth-cta { margin-top: auto; min-height: 44px; font-size: var(--text-base); }
  .wth-tag {
    font-family: var(--font-label); font-weight: 700; font-size: var(--text-xs); letter-spacing: 0.16em; text-transform: uppercase;
    background: var(--purple); color: var(--gold); padding: 4px 12px; border-radius: 999px;
  }
  .wth-card.hot .wth-title { font-size: var(--text-2xl); }
  /* The arrow link on a white card keeps the light-surface color */
  .wth .wth-cta { color: var(--purple); }
  .wth .wth-cta:hover { color: var(--purple-deep); }

  @media (max-width: 960px) {
    .wth-grid { grid-template-columns: 1fr 1fr; }
    .wth-card.hot, .wth-give { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .wth-grid { grid-template-columns: 1fr; gap: var(--space-md); }
    .wth-card { padding: var(--space-lg); }
  }
</style>
