---
// Countdown box: purple-deep with gold digits, counting to whatever `date` is passed (ISO). The number is refreshed by motion.js from data-days-until;
// the static value is computed at build time (in Chicago time; CI rebuilds daily) so
// no-JS readers still see a number. data-clock-state is future | today | past:
// "today" (0 days) lets page copy key off the label; "past" hides the clock.
import { daysUntil, clockState } from '../../scripts/motion.js';
export interface Props { date: string; labelKey: string; label: string; size?: 'md' | 'lg' }
const { date, labelKey, label, size = 'md' } = Astro.props;
const staticDays = daysUntil(date);
const state = clockState(staticDays);
---
<div class:list={['race-clock', `rc-${size}`]} data-clock-state={state} hidden={state === 'past'}>
  <span class="rc-digits stat-tabular" data-days-until={date}>{Math.max(0, staticDays)}</span>
  <span class="rc-label" data-i18n={labelKey} data-clock-label data-clock-state={state}>{label}</span>
</div>

<style>
  .race-clock[hidden] { display: none; }
  .race-clock {
    display: inline-flex; align-items: center; gap: 0.8rem;
    background: var(--purple-deep); color: var(--white); border-radius: var(--radius-md);
    padding: 0.55rem 1rem 0.55rem 0.6rem;
    box-shadow: inset 0 0 0 1px rgba(254, 198, 10, 0.55), 0 10px 26px rgba(29, 10, 46, 0.22);
  }
  .rc-digits {
    font-family: var(--font-display); font-weight: 900; color: var(--gold); line-height: 1;
    font-size: 2.4rem; background: var(--purple-ink); border-radius: 8px; padding: 0.12em 0.32em 0.16em;
    border: 1px solid rgba(254, 198, 10, 0.35);
  }
  .rc-label { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.85rem; line-height: 1.2; max-width: 13ch; }
  .rc-lg .rc-digits { font-size: 3.4rem; }
  .rc-lg .rc-label { font-size: 1rem; }
</style>
