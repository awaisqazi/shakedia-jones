---
// Thin gold arcs (the flyers' swooshes). Decorative; stretches to its box.
// <Swoosh class="my-swoosh" />  <Swoosh flip />  <Swoosh tone="light" />
export interface Props { class?: string; flip?: boolean; tone?: 'gold' | 'light' }
const { class: cls, flip = false, tone = 'gold' } = Astro.props;
---
<svg class:list={['swoosh', cls, { flip }, `swoosh-${tone}`]} viewBox="0 0 600 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d="M0 52 C150 4 450 4 600 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <path d="M40 58 C200 18 430 16 590 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.65" vector-effect="non-scaling-stroke" />
</svg>

<style>
  .swoosh { display: block; width: 100%; height: 40px; color: var(--gold); overflow: visible; }
  .swoosh-light { color: rgba(255, 255, 255, 0.7); }
  .flip { transform: scaleX(-1); }
</style>
