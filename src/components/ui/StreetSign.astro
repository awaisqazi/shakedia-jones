---
// A drawing of the honorary sign as dedicated on July 14, 2024: the green city blade on top,
// the brown honorary blade under it. No block number: the site never points at her home.
export interface Props { class?: string; tilt?: boolean }
const { class: cls, tilt = true } = Astro.props;
---
<div class:list={['street-sign', cls, { tilt }]} role="img" aria-label="The honorary sign as dedicated on July 14, 2024: Shakedia Jones Olympic Way, George Avenue." data-i18n-attr="aria-label:ui.sign_label">
  <div class="blade blade-green" aria-hidden="true">
    <span class="blade-name">George</span>
    <span class="blade-meta"><span>Ave</span></span>
  </div>
  <div class="blade blade-brown" aria-hidden="true">
    <span class="blade-honor">Shakedia Jones Olympic Way</span>
  </div>
  <span class="pole" aria-hidden="true"></span>
</div>

<style>
  .street-sign { position: relative; display: inline-flex; flex-direction: column; align-items: stretch; gap: 6px; padding-bottom: 64px; }
  .street-sign.tilt { transform: rotate(-2.5deg); }
  .blade {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 0.6em;
    border-radius: 7px; padding: 0.35em 0.8em 0.3em;
    box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.92), inset 0 0 0 5px currentColor, 0 10px 24px rgba(13, 27, 62, 0.22);
    font-family: var(--font-label); text-transform: uppercase; color: var(--white);
  }
  .blade-green { background: var(--sign-green); color: var(--sign-green); }
  .blade-brown { background: var(--sign-brown); color: var(--sign-brown); }
  .blade-name { color: var(--white); font-weight: 700; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem); letter-spacing: 0.05em; line-height: 1; }
  .blade-meta { display: flex; flex-direction: column; align-items: flex-end; color: var(--white); font-weight: 700; font-size: clamp(0.9rem, 0.75rem + 0.6vw, 1.2rem); line-height: 1.05; }
  .blade-honor { color: var(--white); font-weight: 700; font-size: clamp(1rem, 0.75rem + 1.1vw, 1.55rem); letter-spacing: 0.04em; white-space: nowrap; line-height: 1.1; }
  .pole {
    position: absolute; left: 50%; top: 10px; bottom: 0; width: 12px; transform: translateX(-50%);
    background: repeating-linear-gradient(180deg, #b9bec8 0 6px, #9ea4b0 6px 9px); border-radius: 3px; z-index: 0;
  }
</style>
