---
// The campaign's Canva-built logos as an <img>. Files live in public/brand/ and are regenerated by
// `npm run brand` (scripts/brand-assets.mjs), which also writes their cropped viewBox sizes to
// src/data/brand-sizes.json so width/height here always match the artwork (no layout shift).
//   variant: wide (one line, "Shakedia Jones" over the band) | stacked (Shakedia / big Jones, band
//            tucked beside the J) | sign (stacked with a full-width band) | seal (round, 120px min:
//            the rim lettering stops reading below that)
//   tone:    light = for light backgrounds (all purple) | dark = for purple backgrounds. Ignored for seal.
//   width:   rendered width in px; CSS may shrink it (max-width: 100%, height: auto).
// Alt text is translated through data-i18n-attr; the English fallback must match shared.en.json.
import sizes from '../../data/brand-sizes.json';
import en from '../../i18n/parts/shared.en.json';

export interface Props {
  variant: 'wide' | 'stacked' | 'sign' | 'seal';
  tone?: 'light' | 'dark';
  width: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const { variant, tone = 'light', width, class: cls, loading = 'lazy' } = Astro.props;
const name = (variant === 'seal' ? 'seal' : `logo-${variant}-${tone}`) as keyof typeof sizes;
const { w, h } = sizes[name];
const height = Math.round((width * h) / w);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const altKey = variant === 'seal' ? 'seal_alt' : 'logo_alt';
---
<img
  class:list={['logo', `logo-${variant}`, cls]}
  src={`${base}/brand/${name}.svg`}
  width={width}
  height={height}
  alt={en.brand[altKey]}
  data-i18n-attr={`alt:brand.${altKey}`}
  decoding="async"
  loading={loading}
/>

<style>
  .logo { display: block; max-width: 100%; height: auto; }
</style>
