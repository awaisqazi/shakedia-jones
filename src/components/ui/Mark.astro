---
// The campaign mark: a purple tile with a gold star over a white serif "1" (the 1st Ward).
// Drawn with plain shapes, no font dependency. Mirrored in public/favicon.svg and public/brand/;
// keep them in sync. Variants: purple (default), deep (dark purple tile), mono (currentColor tile).
export interface Props { size?: number; class?: string; variant?: 'purple' | 'deep' | 'mono' }
const { size = 40, class: cls, variant = 'purple' } = Astro.props;
const tile = variant === 'deep' ? '#2b0747' : variant === 'mono' ? 'currentColor' : '#4a0375';
const star = variant === 'mono' ? '#fbf7ef' : '#fec60a';
---
<svg class={cls} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <rect width="48" height="48" rx="11" fill={tile} />
  <path fill={star} d="M24 5.6L25.56 10.06L30.28 10.16L26.52 13.02L27.88 17.54L24 14.85L20.12 17.54L21.48 13.02L17.72 10.16L22.44 10.06Z" />
  <path fill="#fff" d="M27.2 20.5V36.9H31V40.6H17V36.9H21.4V26.4L17.4 28V24.4L25 20.5Z" />
</svg>
