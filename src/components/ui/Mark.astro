---
// The campaign mark: a round purple-and-gold "1st" medal (gold ring, gold "1", raised white "ST"
// over a gold bar). Made in Canva as a sibling of the campaign seal; it reads on light and dark
// surfaces alike, so there is one mark and no colour variants. Text is outlined, no font dependency.
// Files: public/brand/mark.svg (44px and up), public/brand/mark-small.svg (below 44px: the same
// disc with just the "1", since "ST" turns to mush), public/favicon.svg (plain disc + "1").
// smallBelow: viewport width (px) at or under which CSS shrinks this mark below 44px, so the
// small artwork is swapped in there.
export interface Props { size?: number; class?: string; smallBelow?: number }
const { size = 44, class: cls, smallBelow } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = `${base}/brand/mark.svg`;
const small = `${base}/brand/mark-small.svg`;
const src = size < 44 ? small : full;
---
{smallBelow && src === full ? (
  <picture class="mark-pic">
    <source media={`(max-width: ${smallBelow}px)`} srcset={small} />
    <img class:list={['mark', cls]} src={full} width={size} height={size} alt="" />
  </picture>
) : (
  <img class:list={['mark', cls]} src={src} width={size} height={size} alt="" />
)}

<style>
  /* the <picture> wrapper must not become its own box, so flex/size rules hit the <img> */
  .mark-pic { display: contents; }
  /* ...and its <source> must not either, or it becomes an empty flex item that eats a gap */
  .mark-pic > source { display: none; }
  .mark { display: block; flex-shrink: 0; }
</style>
