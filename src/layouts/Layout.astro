---
import '../styles/global.css';
import { Font } from 'astro:assets';
import MobileActionBar from '../components/MobileActionBar.astro';

export interface Props {
  title?: string;
  description?: string;
  actionBar?: boolean;
  /** Adds robots noindex and skips the canonical tag (404 page). */
  noindex?: boolean;
}

const {
  title = 'Shakedia Jones for 1st Ward Alderperson | Waukegan',
  description = 'Shakedia Jones, 2000 U.S. Olympic Team member, nine-time Illinois state champion and founder of Furthering the Lives of Youth (FLY), is running for 1st Ward Alderperson in Waukegan.',
  actionBar = true,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/images/og-card.jpg`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(`${base}/`, Astro.site).href;
// Page slug for i18n meta.<slug>.title / description: "/shakedia-jones/meet/" -> "meet".
const page = Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/g, '').replace(/\.html$/, '').replace(/\//g, '-') || 'home';
const isHome = page === 'home';
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Shakedia Jones',
  url: homeUrl,
  image: ogImage,
  jobTitle: 'Candidate for 1st Ward Alderperson, Waukegan',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Runs before CSS: .js gates the scroll-reveal hiding (no-JS readers see everything),
         and lang is set early from ?lang= or the saved choice (text swaps on load). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var q = new URLSearchParams(location.search).get('lang');
          var s = null;
          try { s = localStorage.getItem('sj-lang'); } catch (e) {}
          var l = q === 'en' || q === 'es' ? q : s === 'es' ? 'es' : 'en';
          d.setAttribute('lang', l);
        } catch (e) {}
      })();
    </script>
    <Font cssVariable="--ff-display" preload={[{ weight: 800 }]} />
    <Font cssVariable="--ff-body" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--ff-label" preload={[{ weight: 700 }]} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f2ea" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shakedia Jones for Waukegan" />
    <meta property="og:url" content={noindex ? homeUrl : pageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shakedia Jones for Waukegan. Olympian. Coach. Neighbor." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Shakedia Jones for Waukegan. Olympian. Coach. Neighbor." />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main" data-i18n="nav.skip">Skip to content</a>
    <slot />
    {actionBar && <MobileActionBar />}

    <script>
      import { initI18n } from '../i18n/i18n.js';
      import { initMotion } from '../scripts/motion.js';
      // Module scripts can run after DOMContentLoaded (always in dev), so init either way.
      // Each init is isolated: if motion throws, everything is revealed instead of left hidden.
      const init = () => {
        try { initI18n(); } catch (e) { console.error(e); }
        try { initMotion(); } catch (e) {
          console.error(e);
          document.querySelectorAll('.animate-in').forEach((el) => el.classList.add('visible'));
        }
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute; left: -999px; top: 8px; z-index: 10001;
    background: var(--gold); color: var(--navy); padding: 8px 14px; border-radius: 999px; font-weight: 700;
  }
  .skip-link:focus { left: 8px; }
</style>
